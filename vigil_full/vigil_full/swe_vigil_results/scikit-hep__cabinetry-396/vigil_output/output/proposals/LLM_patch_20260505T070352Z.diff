diff --git a/agent.py b/agent.py
index 9d7f4b1..c2e8a91 100644
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,63 @@
+import json
+import logging
+import random
+import time
+
+logger = logging.getLogger(__name__)
+
+
+def _log_structured_event(level, *, event, cause, **fields):
+    """Emit machine-readable agent telemetry without hiding user-facing errors."""
+    payload = {
+        "event": event,
+        "cause": cause,
+        **fields,
+    }
+    logger.log(level, json.dumps(payload, sort_keys=True, default=str))
+
+
+def submit_with_observability(submit_callable, *args, retries=1, jitter_seconds=0.25, **kwargs):
+    """Call an agent submit function with one bounded retry and structured errors.
+
+    Recent reflection identified ``agent.submit`` failures as the primary thorn.
+    This helper preserves successful submit behavior while making failures
+    diagnosable and resilient: the original callable is used unchanged, failures
+    are logged with the stable cause code ``agent.submit:fail``, and a single
+    jittered retry is attempted before re-raising the final exception.
+    """
+    attempts = max(0, int(retries)) + 1
+    last_error = None
+
+    for attempt in range(1, attempts + 1):
+        try:
+            result = submit_callable(*args, **kwargs)
+            _log_structured_event(
+                logging.INFO,
+                event="agent.submit",
+                cause="agent.submit:ok",
+                attempt=attempt,
+                retries=retries,
+            )
+            return result
+        except Exception as exc:
+            last_error = exc
+            _log_structured_event(
+                logging.ERROR,
+                event="agent.submit",
+                cause="agent.submit:fail",
+                attempt=attempt,
+                retries=retries,
+                error_type=type(exc).__name__,
+                error=str(exc),
+            )
+            if attempt >= attempts:
+                break
+            time.sleep(random.uniform(0, max(0.0, float(jitter_seconds))))
+
+    raise last_error
+
