diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,62 @@
+import json
+import logging
+import random
+import time
+
+logger = logging.getLogger(__name__)
+
+
+def _log_structured_agent_event(event, *, cause, status, detail=None, **fields):
+    """Emit structured agent telemetry with stable cause codes.
+
+    This helper is intentionally dependency-free so submit and tool-call paths can
+    report failures consistently without changing their public behaviour.
+    """
+    payload = {
+        "event": event,
+        "cause": cause,
+        "status": status,
+    }
+    if detail is not None:
+        payload["detail"] = str(detail)
+    payload.update(fields)
+    logger.info("agent_event %s", json.dumps(payload, sort_keys=True))
+
+
+def _with_single_retry(operation, *, cause, event="agent.submit", jitter_seconds=0.25):
+    """Run an operation, retrying once after structured failure logging.
+
+    The recent RBT diagnosis identified agent.submit failures as the primary
+    thorn. Wrapping submit-like operations with this helper preserves successful
+    behaviour while surfacing cause-coded failures and giving transient errors one
+    bounded retry.
+    """
+    try:
+        result = operation()
+        _log_structured_agent_event(event, cause=cause, status="ok")
+        return result
+    except Exception as exc:
+        _log_structured_agent_event(
+            event,
+            cause=cause,
+            status="fail",
+            detail=exc,
+            attempt=1,
+        )
+        time.sleep(random.uniform(0, jitter_seconds))
+        try:
+            result = operation()
+            _log_structured_agent_event(event, cause=cause, status="ok", attempt=2)
+            return result
+        except Exception as retry_exc:
+            _log_structured_agent_event(
+                event,
+                cause=cause,
+                status="fail",
+                detail=retry_exc,
+                attempt=2,
+            )
+            raise
+
