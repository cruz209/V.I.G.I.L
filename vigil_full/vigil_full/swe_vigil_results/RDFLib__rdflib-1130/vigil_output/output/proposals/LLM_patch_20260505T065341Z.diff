--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,57 @@
+import json
+import logging
+import random
+import time
+from functools import wraps
+
+logger = logging.getLogger(__name__)
+
+
+def log_structured_error(cause_code, exc, **context):
+    """Emit machine-readable failure telemetry for agent operations."""
+    payload = {
+        "event": "agent.error",
+        "cause": cause_code,
+        "error_type": type(exc).__name__,
+        "error": str(exc),
+        "context": context,
+    }
+    logger.error(json.dumps(payload, sort_keys=True))
+
+
+def retry_once_with_jitter(cause_code, base_delay=0.25, max_jitter=0.25):
+    """Retry a failing operation once and log both failed attempts with cause codes."""
+    def decorator(fn):
+        @wraps(fn)
+        def wrapper(*args, **kwargs):
+            try:
+                return fn(*args, **kwargs)
+            except Exception as first_error:
+                log_structured_error(
+                    cause_code,
+                    first_error,
+                    attempt=1,
+                    function=fn.__name__,
+                )
+                time.sleep(base_delay + random.random() * max_jitter)
+                try:
+                    return fn(*args, **kwargs)
+                except Exception as second_error:
+                    log_structured_error(
+                        cause_code,
+                        second_error,
+                        attempt=2,
+                        function=fn.__name__,
+                    )
+                    raise
+        return wrapper
+    return decorator
+
+
+def submit_with_observability(submit_callable, *args, **kwargs):
+    """Run agent.submit-style calls with structured telemetry and one jittered retry."""
+    @retry_once_with_jitter("agent.submit:fail")
+    def _submit():
+        return submit_callable(*args, **kwargs)
+
+    return _submit()
+
