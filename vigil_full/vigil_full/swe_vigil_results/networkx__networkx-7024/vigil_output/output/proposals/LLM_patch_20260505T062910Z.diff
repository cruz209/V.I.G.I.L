diff --git a/agent.py b/agent.py
index 1111111..2222222 100644
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,55 @@
+import json
+import logging
+import random
+import time
+
+logger = logging.getLogger(__name__)
+
+
+def _log_structured_submit_error(cause_code, error, attempt, **context):
+    """Emit structured diagnostics for agent.submit failures.
+
+    The RBT review identified `agent.submit:fail` as the current top thorn.
+    Keep this helper small and dependency-free so submit paths can report a
+    stable cause code that downstream log processors can aggregate.
+    """
+    payload = {
+        "event": "agent.submit",
+        "status": "fail",
+        "cause_code": cause_code,
+        "attempt": attempt,
+        "error_type": type(error).__name__,
+        "error": str(error),
+    }
+    payload.update(context)
+    logger.error("agent.submit failed: %s", json.dumps(payload, sort_keys=True))
+
+
+def submit_with_observability(submit_callable, *args, max_attempts=2, jitter_seconds=0.25, **kwargs):
+    """Run an agent.submit callable with one retry and structured errors.
+
+    Args:
+        submit_callable: Callable that performs the submit operation.
+        *args: Positional arguments forwarded to the submit callable.
+        max_attempts: Total attempts, defaulting to initial try + one retry.
+        jitter_seconds: Upper bound for retry jitter.
+        **kwargs: Keyword arguments forwarded to the submit callable.
+
+    Returns:
+        The submit callable's return value.
+
+    Raises:
+        The final exception after all attempts are exhausted.
+    """
+    attempts = max(1, int(max_attempts))
+    for attempt in range(1, attempts + 1):
+        try:
+            result = submit_callable(*args, **kwargs)
+            logger.info(
+                "agent.submit succeeded: %s",
+                json.dumps({"event": "agent.submit", "status": "ok", "attempt": attempt}, sort_keys=True),
+            )
+            return result
+        except Exception as exc:
+            _log_structured_submit_error("agent.submit.exception", exc, attempt)
+            if attempt >= attempts:
+                raise
+            time.sleep(random.uniform(0, max(0.0, float(jitter_seconds))))
+
