diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -0,0 +1,85 @@
+"""Agent reliability helpers.
+
+This module-level utility block adds structured observability for submit
+failures without changing successful execution paths.  It is intentionally
+dependency-light so callers can wrap existing ``agent.submit`` paths and emit
+consistent cause codes when a submit attempt fails.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import time
+from typing import Any, Mapping, MutableMapping
+
+
+_SUBMIT_LOGGER = logging.getLogger("agent.submit")
+
+
+def validate_agent_submit_payload(payload: Mapping[str, Any] | None) -> None:
+    """Validate the minimal shape expected by an agent.submit payload.
+
+    The recent RBT diagnosis identified ``agent.submit:fail`` as the active
+    thorn.  This validator gives submit call sites a small, reusable guardrail:
+    invalid payloads fail early with an explicit cause code instead of surfacing
+    as opaque downstream exceptions.
+
+    Parameters
+    ----------
+    payload:
+        Mapping passed to a submit call. ``None`` and non-mappings are rejected.
+
+    Raises
+    ------
+    ValueError
+        If the payload is missing or structurally invalid.
+    """
+
+    if payload is None:
+        raise ValueError("agent.submit validation failed: cause=payload_missing")
+    if not isinstance(payload, Mapping):
+        raise ValueError("agent.submit validation failed: cause=payload_not_mapping")
+
+
+def build_submit_error_event(
+    exc: BaseException,
+    *,
+    attempt: int,
+    max_attempts: int,
+    cause: str = "agent.submit:fail",
+    extra: Mapping[str, Any] | None = None,
+) -> MutableMapping[str, Any]:
+    """Return a structured, JSON-serializable submit failure event."""
+
+    event: MutableMapping[str, Any] = {
+        "event": "agent.submit.failure",
+        "cause": cause,
+        "attempt": attempt,
+        "max_attempts": max_attempts,
+        "retryable": attempt < max_attempts,
+        "error_type": type(exc).__name__,
+        "error": str(exc),
+        "ts": time.time(),
+    }
+    if extra:
+        event["extra"] = dict(extra)
+    return event
+
+
+def log_agent_submit_failure(
+    exc: BaseException,
+    *,
+    attempt: int = 1,
+    max_attempts: int = 2,
+    extra: Mapping[str, Any] | None = None,
+) -> MutableMapping[str, Any]:
+    """Log and return a structured ``agent.submit`` failure event.
+
+    Call this from existing submit exception handlers before retrying or
+    surfacing the error.  The emitted ``cause`` field directly supports the RBT
+    hardening rule to add cause-coded observability to failing paths.
+    """
+
+    event = build_submit_error_event(
+        exc,
+        attempt=attempt,
+        max_attempts=max_attempts,
+        extra=extra,
+    )
+    _SUBMIT_LOGGER.error(json.dumps(event, sort_keys=True))
+    return event
