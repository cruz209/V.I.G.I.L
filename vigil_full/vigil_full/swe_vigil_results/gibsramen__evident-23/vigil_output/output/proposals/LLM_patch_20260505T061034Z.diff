diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,0 +1,88 @@
+def submit_with_observability(submit_callable, *args, logger=None, retries=1, jitter_seconds=0.25, **kwargs):
+    """Call an agent.submit-like function with structured logging and one retry.
+
+    Recent RBT diagnosis identified ``agent.submit:fail`` as the primary thorn.
+    This helper centralizes the mitigation so submit paths can surface stable
+    cause codes, preserve successful behavior, and retry transient failures once
+    with a small jitter.
+
+    Parameters
+    ----------
+    submit_callable:
+        Callable that performs the submit operation.
+    *args, **kwargs:
+        Forwarded unchanged to ``submit_callable``.
+    logger:
+        Optional stdlib-compatible logger. If omitted, a module logger is used.
+    retries:
+        Number of retry attempts after the initial failure. Defaults to 1.
+    jitter_seconds:
+        Upper bound for randomized retry delay. Set to 0 to disable sleeping.
+
+    Returns
+    -------
+    Any
+        The value returned by ``submit_callable``.
+
+    Raises
+    ------
+    Exception
+        Re-raises the final exception after structured error logging.
+    """
+    import logging
+    import random
+    import time
+
+    log = logger or logging.getLogger(__name__)
+    operation = getattr(submit_callable, "__name__", "agent.submit")
+    max_attempts = max(1, int(retries) + 1)
+
+    for attempt in range(1, max_attempts + 1):
+        try:
+            result = submit_callable(*args, **kwargs)
+            log.info(
+                "agent_submit_ok",
+                extra={
+                    "cause_code": "agent.submit:ok",
+                    "operation": operation,
+                    "attempt": attempt,
+                    "max_attempts": max_attempts,
+                },
+            )
+            return result
+        except Exception as exc:
+            is_final = attempt >= max_attempts
+            log.warning(
+                "agent_submit_fail",
+                extra={
+                    "cause_code": "agent.submit:fail",
+                    "operation": operation,
+                    "attempt": attempt,
+                    "max_attempts": max_attempts,
+                    "final": is_final,
+                    "error_type": type(exc).__name__,
+                    "error": str(exc),
+                },
+                exc_info=True,
+            )
+            if is_final:
+                raise
+            if jitter_seconds and jitter_seconds > 0:
+                time.sleep(random.uniform(0, jitter_seconds))
+
+    # Defensive fallback for static analyzers; the loop either returns or raises.
+    raise RuntimeError("submit_with_observability exited unexpectedly")
+
