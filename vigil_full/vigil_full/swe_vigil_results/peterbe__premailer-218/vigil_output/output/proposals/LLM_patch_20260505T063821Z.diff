diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,56 @@
+import json
+import logging
+import random
+import time
+
+logger = logging.getLogger(__name__)
+
+
+def log_structured_agent_error(cause_code, exc, **context):
+    """Emit structured diagnostics for agent failure paths.
+
+    The RBT review identified ``agent.submit`` as the top thorn.  Keeping the
+    error payload machine-readable makes future log processing and remediation
+    less brittle while preserving the original exception for callers.
+    """
+    payload = {
+        "event": "agent.error",
+        "cause": cause_code,
+        "error_type": type(exc).__name__,
+        "error": str(exc),
+        "context": context,
+    }
+    logger.error(json.dumps(payload, sort_keys=True), exc_info=True)
+
+
+def submit_with_observability(submit_callable, *args, retries=1, jitter_seconds=0.25, **kwargs):
+    """Run an agent submit callable with structured logging and one retry.
+
+    This helper is intentionally small so existing submit behavior can opt in
+    without changing successful paths.  Failures are logged with a stable cause
+    code and retried once with light jitter before the final exception is
+    re-raised.
+    """
+    attempts = retries + 1
+    for attempt in range(1, attempts + 1):
+        try:
+            return submit_callable(*args, **kwargs)
+        except Exception as exc:
+            log_structured_agent_error(
+                "agent.submit:fail",
+                exc,
+                attempt=attempt,
+                max_attempts=attempts,
+                submit_callable=getattr(submit_callable, "__name__", repr(submit_callable)),
+            )
+            if attempt >= attempts:
+                raise
+            time.sleep(random.uniform(0, jitter_seconds))
+
