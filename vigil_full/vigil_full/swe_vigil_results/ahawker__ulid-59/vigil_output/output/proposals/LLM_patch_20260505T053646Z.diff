+"""Agent runtime helpers.
+
+This module includes lightweight observability utilities used by the agent
+submission path.  They are intentionally dependency-free so failures in the
+reporting path cannot mask the original agent.submit error.
+"""
+
+from __future__ import annotations
+
+import functools
+import json
+import logging
+import random
+import time
+from typing import Any, Callable, TypeVar
+
+
+LOGGER = logging.getLogger(__name__)
+F = TypeVar("F", bound=Callable[..., Any])
+
+
+def log_structured_error(cause_code: str, error: BaseException, **context: Any) -> None:
+    """Emit a structured error log with a stable cause code.
+
+    The recent RBT diagnosis identified ``agent.submit:fail`` as the active
+    thorn.  This helper standardizes failure telemetry so retries and future
+    debugging can distinguish submission failures from other runtime errors.
+    """
+    payload = {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "error_type": type(error).__name__,
+        "error": str(error),
+        "context": context,
+    }
+    LOGGER.error(json.dumps(payload, sort_keys=True), exc_info=error)
+
+
+def retry_once_with_jitter(
+    cause_code: str,
+    *,
+    min_delay_seconds: float = 0.05,
+    max_delay_seconds: float = 0.25,
+) -> Callable[[F], F]:
+    """Retry a failing operation once and log both attempts structurally."""
+    if min_delay_seconds < 0 or max_delay_seconds < min_delay_seconds:
+        raise ValueError("retry jitter bounds must be non-negative and ordered")
+
+    def decorator(func: F) -> F:
+        @functools.wraps(func)
+        def wrapper(*args: Any, **kwargs: Any) -> Any:
+            try:
+                return func(*args, **kwargs)
+            except Exception as first_error:  # pragma: no cover - exercised by callers
+                log_structured_error(cause_code, first_error, attempt=1, retrying=True)
+                time.sleep(random.uniform(min_delay_seconds, max_delay_seconds))
+                try:
+                    return func(*args, **kwargs)
+                except Exception as retry_error:
+                    log_structured_error(cause_code, retry_error, attempt=2, retrying=False)
+                    raise
+
+        return wrapper  # type: ignore[return-value]
+
+    return decorator
+
