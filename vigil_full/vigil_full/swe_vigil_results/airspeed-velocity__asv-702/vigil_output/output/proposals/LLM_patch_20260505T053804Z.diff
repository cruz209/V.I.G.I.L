diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -0,0 +1,107 @@
+"""Agent reliability helpers.
+
+This module-level utility is intentionally dependency-light so it can be used
+from any existing agent submit path.  It adds structured observability and one
+bounded retry for the `agent.submit` thorn diagnosed from recent logs.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import random
+import time
+from typing import Any, Callable, Optional, TypeVar
+
+
+T = TypeVar("T")
+
+
+def _structured_log(
+    logger: logging.Logger,
+    level: int,
+    event: str,
+    *,
+    cause_code: str,
+    attempt: int,
+    max_attempts: int,
+    error: Optional[BaseException] = None,
+    extra: Optional[dict[str, Any]] = None,
+) -> None:
+    """Emit a single-line JSON log record for submit observability."""
+    payload: dict[str, Any] = {
+        "event": event,
+        "cause_code": cause_code,
+        "attempt": attempt,
+        "max_attempts": max_attempts,
+    }
+    if error is not None:
+        payload.update(
+            {
+                "error_type": type(error).__name__,
+                "error_message": str(error),
+            }
+        )
+    if extra:
+        payload.update(extra)
+    logger.log(level, json.dumps(payload, sort_keys=True))
+
+
+def submit_with_observability(
+    submit_callable: Callable[..., T],
+    *args: Any,
+    cause_code: str = "agent.submit",
+    max_attempts: int = 2,
+    base_delay_seconds: float = 0.25,
+    logger: Optional[logging.Logger] = None,
+    **kwargs: Any,
+) -> T:
+    """Call a submit function with structured logging and one retry.
+
+    Recent RBT diagnosis identified `agent.submit:fail` as the top thorn. This
+    wrapper preserves successful submit behavior while improving failed paths:
+    failures are surfaced as structured error logs and retried once with jitter.
+
+    Example:
+        result = submit_with_observability(agent.submit, payload)
+
+    Args:
+        submit_callable: The existing submit function/method to invoke.
+        *args: Positional arguments forwarded to ``submit_callable``.
+        cause_code: Stable cause identifier for logs and downstream diagnosis.
+        max_attempts: Total attempts; defaults to two (initial + one retry).
+        base_delay_seconds: Base sleep before retry; jitter is added.
+        logger: Optional logger. Defaults to this module's logger.
+        **kwargs: Keyword arguments forwarded to ``submit_callable``.
+
+    Returns:
+        The return value from ``submit_callable``.
+
+    Raises:
+        The final exception raised by ``submit_callable`` after all attempts.
+    """
+    if max_attempts < 1:
+        raise ValueError("max_attempts must be >= 1")
+    if base_delay_seconds < 0:
+        raise ValueError("base_delay_seconds must be >= 0")
+
+    log = logger or logging.getLogger(__name__)
+    last_error: Optional[BaseException] = None
+
+    for attempt in range(1, max_attempts + 1):
+        try:
+            result = submit_callable(*args, **kwargs)
+            _structured_log(
+                log,
+                logging.INFO,
+                "submit_success",
+                cause_code=cause_code,
+                attempt=attempt,
+                max_attempts=max_attempts,
+            )
+            return result
+        except Exception as exc:  # noqa: BLE001 - deliberately logs/retries all submit failures.
+            last_error = exc
+            _structured_log(
+                log,
+                logging.ERROR,
+                "submit_failure",
+                cause_code=f"{cause_code}:fail",
+                attempt=attempt,
+                max_attempts=max_attempts,
+                error=exc,
+            )
+            if attempt >= max_attempts:
+                raise
+            time.sleep(base_delay_seconds + random.uniform(0, base_delay_seconds))
+
+    # Unreachable, but keeps type-checkers aware that this function either
+    # returns a submit result or raises the final submit exception.
+    raise RuntimeError("submit failed without raising a captured exception") from last_error
