diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,61 @@
+import functools
+import json
+import logging
+import random
+import time
+
+LOGGER = logging.getLogger(__name__)
+
+
+def _log_structured_submit_error(exc, *, attempt, max_attempts, cause_code="agent.submit:fail"):
+    """Emit structured diagnostics for agent.submit failures.
+
+    Recent RBT diagnosis identified agent.submit as the top thorn.  Keeping the
+    log payload machine-readable makes future log processing able to attribute
+    failures to a stable cause code instead of parsing free-form text.
+    """
+    LOGGER.error(
+        "agent submit failed",
+        extra={
+            "event": "agent.submit",
+            "status": "fail",
+            "cause_code": cause_code,
+            "attempt": attempt,
+            "max_attempts": max_attempts,
+            "error_type": type(exc).__name__,
+            "error_message": str(exc),
+        },
+    )
+
+
+def retry_agent_submit(max_attempts=2, base_delay_s=0.2, jitter_s=0.15):
+    """Retry an agent.submit-like callable once and log structured failures.
+
+    Usage:
+        submit = retry_agent_submit()(submit)
+
+    The default gives the initial attempt plus one retry with small jitter, which
+    follows the RBT remediation rule without masking persistent failures.
+    """
+    if max_attempts < 1:
+        raise ValueError("max_attempts must be >= 1")
+
+    def decorator(func):
+        @functools.wraps(func)
+        def wrapper(*args, **kwargs):
+            last_exc = None
+            for attempt in range(1, max_attempts + 1):
+                try:
+                    result = func(*args, **kwargs)
+                    LOGGER.info(
+                        "agent submit succeeded",
+                        extra={"event": "agent.submit", "status": "ok", "attempt": attempt},
+                    )
+                    return result
+                except Exception as exc:  # pragma: no cover - preserves original exception after retry
+                    last_exc = exc
+                    _log_structured_submit_error(exc, attempt=attempt, max_attempts=max_attempts)
+                    if attempt < max_attempts:
+                        time.sleep(base_delay_s + random.random() * jitter_s)
+            raise last_exc
+
+        return wrapper
+
+    return decorator
+
