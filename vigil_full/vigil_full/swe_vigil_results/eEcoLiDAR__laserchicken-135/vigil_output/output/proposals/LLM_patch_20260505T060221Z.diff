diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -0,0 +1,84 @@
+"""Agent reliability helpers.
+
+This module-level utility provides structured submit observability and a
+single retry with jitter for transient failures. It is intentionally small and
+dependency-free so existing agent code can wrap submit operations without
+changing their external behavior.
+"""
+
+from __future__ import annotations
+
+import logging
+import random
+import time
+from typing import Any, Callable, Dict, Optional, TypeVar
+
+
+LOGGER = logging.getLogger(__name__)
+T = TypeVar("T")
+
+
+def log_agent_event(
+    event: str,
+    *,
+    cause_code: str,
+    status: str,
+    attempt: int = 1,
+    error: Optional[BaseException] = None,
+    **fields: Any,
+) -> None:
+    """Emit a structured agent event with a stable cause code.
+
+    Stable cause codes make failures such as ``agent.submit:fail`` searchable in
+    logs and allow reflective diagnostics to identify recurring thorns.
+    """
+    payload: Dict[str, Any] = {
+        "event": event,
+        "cause_code": cause_code,
+        "status": status,
+        "attempt": attempt,
+        **fields,
+    }
+    if error is not None:
+        payload["error_type"] = type(error).__name__
+        payload["error"] = str(error)
+
+    if status == "fail":
+        LOGGER.error("agent_event", extra={"agent_event": payload})
+    else:
+        LOGGER.info("agent_event", extra={"agent_event": payload})
+
+
+def call_with_submit_retry(
+    submit_fn: Callable[..., T],
+    *args: Any,
+    max_attempts: int = 2,
+    base_delay_seconds: float = 0.2,
+    jitter_seconds: float = 0.15,
+    **kwargs: Any,
+) -> T:
+    """Call an agent submit function, retrying once with jitter on failure.
+
+    The original exception is re-raised after the final failed attempt so callers
+    keep their current error semantics while gaining structured observability.
+    """
+    if max_attempts < 1:
+        raise ValueError("max_attempts must be at least 1")
+
+    last_error: Optional[BaseException] = None
+    for attempt in range(1, max_attempts + 1):
+        try:
+            result = submit_fn(*args, **kwargs)
+            log_agent_event(
+                "agent.submit",
+                cause_code="agent.submit:ok",
+                status="ok",
+                attempt=attempt,
+            )
+            return result
+        except Exception as exc:
+            last_error = exc
+            log_agent_event(
+                "agent.submit",
+                cause_code="agent.submit:fail",
+                status="fail",
+                attempt=attempt,
+                error=exc,
+            )
+            if attempt < max_attempts:
+                time.sleep(base_delay_seconds + random.uniform(0.0, jitter_seconds))
+
+    assert last_error is not None
+    raise last_error
