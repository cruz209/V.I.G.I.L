@@ -1,3 +1,54 @@
+import logging
+import random
+import time
+
+LOGGER = logging.getLogger(__name__)
+
+
+def submit_with_observability(submit_fn, *args, max_attempts=2, base_delay=0.1, **kwargs):
+    """Run agent.submit-like callables with structured logging and one retry.
+
+    Recent RBT diagnostics identified ``agent.submit:fail`` as the primary
+    thorn.  This helper preserves the existing submit behavior on success while
+    making failures visible with stable cause codes and retrying once with
+    jitter before surfacing the original error.
+    """
+    attempts = max(1, int(max_attempts))
+    for attempt in range(1, attempts + 1):
+        try:
+            result = submit_fn(*args, **kwargs)
+            LOGGER.info(
+                "agent.submit succeeded",
+                extra={
+                    "cause_code": "agent.submit:ok",
+                    "attempt": attempt,
+                    "max_attempts": attempts,
+                },
+            )
+            return result
+        except Exception as exc:
+            LOGGER.warning(
+                "agent.submit failed",
+                extra={
+                    "cause_code": "agent.submit:fail",
+                    "attempt": attempt,
+                    "max_attempts": attempts,
+                    "error_type": type(exc).__name__,
+                },
+                exc_info=True,
+            )
+            if attempt >= attempts:
+                LOGGER.error(
+                    "agent.submit exhausted retries",
+                    extra={
+                        "cause_code": "agent.submit:exhausted",
+                        "attempt": attempt,
+                        "max_attempts": attempts,
+                        "error_type": type(exc).__name__,
+                    },
+                    exc_info=True,
+                )
+                raise
+            time.sleep(base_delay + random.uniform(0, base_delay))
+
