--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,53 @@
+import json
+import logging
+from datetime import datetime, timezone
+from typing import Any, Mapping, Optional
+
+
+AGENT_SUBMIT_FAILURE_CAUSE = "agent.submit:fail"
+
+
+def log_agent_submit_failure(
+    exc: BaseException,
+    *,
+    logger: Optional[logging.Logger] = None,
+    **context: Any,
+) -> None:
+    """Emit structured observability for failed agent.submit paths.
+
+    Recent reflection identified ``agent.submit:fail`` as the top thorn.  This
+    helper gives submit call sites a consistent cause code and machine-readable
+    context while preserving the original exception semantics for callers that
+    choose to re-raise after logging.
+    """
+    active_logger = logger or logging.getLogger(__name__)
+    payload = {
+        "event": "agent.submit.failure",
+        "cause": AGENT_SUBMIT_FAILURE_CAUSE,
+        "exception_type": type(exc).__name__,
+        "exception": str(exc),
+        "ts": datetime.now(timezone.utc).isoformat(),
+    }
+    payload.update(_safe_log_context(context))
+    active_logger.error(json.dumps(payload, sort_keys=True))
+
+
+def _safe_log_context(context: Mapping[str, Any]) -> dict[str, Any]:
+    """Return JSON-serializable log context without raising from logging."""
+    safe_context: dict[str, Any] = {}
+    for key, value in context.items():
+        if value is None:
+            continue
+        try:
+            json.dumps(value)
+        except (TypeError, ValueError):
+            safe_context[key] = repr(value)
+        else:
+            safe_context[key] = value
+    return safe_context
+
