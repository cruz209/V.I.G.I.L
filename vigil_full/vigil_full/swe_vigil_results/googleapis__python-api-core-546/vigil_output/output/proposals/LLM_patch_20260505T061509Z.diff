diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,71 @@
+import json
+import logging
+import random
+import time
+from typing import Any, Callable, Dict, Optional
+
+
+_AGENT_LOGGER = logging.getLogger(__name__)
+
+
+def _log_structured_agent_error(
+    *,
+    cause_code: str,
+    exc: BaseException,
+    attempt: int,
+    max_attempts: int,
+    logger: Optional[logging.Logger] = None,
+) -> Dict[str, Any]:
+    """Emit a structured error for agent operation failures.
+
+    RBT identified `agent.submit:fail` as the current thorn.  This helper keeps
+    the failing path observable without changing successful behavior.
+    """
+    event = {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "attempt": attempt,
+        "max_attempts": max_attempts,
+        "error_type": type(exc).__name__,
+        "error": str(exc),
+    }
+    (logger or _AGENT_LOGGER).error(json.dumps(event, sort_keys=True))
+    return event
+
+
+def submit_with_observability(
+    submit_fn: Callable[..., Any],
+    *args: Any,
+    cause_code: str = "agent.submit:fail",
+    retries: int = 1,
+    base_delay_seconds: float = 0.25,
+    logger: Optional[logging.Logger] = None,
+    **kwargs: Any,
+) -> Any:
+    """Call an agent submit function with one retry and structured logging.
+
+    Successful calls are returned unchanged.  On failure, the error is logged
+    with a cause code and retried once with small jitter before surfacing the
+    final exception to the caller.
+    """
+    max_attempts = max(1, retries + 1)
+    for attempt in range(1, max_attempts + 1):
+        try:
+            return submit_fn(*args, **kwargs)
+        except Exception as exc:
+            _log_structured_agent_error(
+                cause_code=cause_code,
+                exc=exc,
+                attempt=attempt,
+                max_attempts=max_attempts,
+                logger=logger,
+            )
+            if attempt >= max_attempts:
+                raise
+            delay = base_delay_seconds + random.uniform(0, base_delay_seconds)
+            time.sleep(delay)
+
