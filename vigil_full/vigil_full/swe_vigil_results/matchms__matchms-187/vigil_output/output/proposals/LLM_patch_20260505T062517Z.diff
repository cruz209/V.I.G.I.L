diff --git a/agent.py b/agent.py
index 2b5c6a1..7c8d9e0 100644
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,79 @@
+import json
+import logging
+import random
+import time
+
+LOGGER = logging.getLogger(__name__)
+
+
+def _structured_agent_error(cause_code, exc, **context):
+    """Return a JSON-serialisable structured error payload for agent failures."""
+    return {
+        "cause_code": cause_code,
+        "error_type": type(exc).__name__,
+        "error": str(exc),
+        "context": context,
+    }
+
+
+def log_structured_agent_error(cause_code, exc, **context):
+    """Log agent failures with stable cause codes for downstream RBT analysis."""
+    payload = _structured_agent_error(cause_code, exc, **context)
+    LOGGER.error("agent_failure %s", json.dumps(payload, sort_keys=True), exc_info=True)
+    return payload
+
+
+def submit_with_observability(submit_callable, *args, retries=1, jitter_seconds=0.25, **kwargs):
+    """Call an agent submit function with structured logging and one jittered retry.
+
+    This hardens the observed thorn `agent.submit:fail` without changing successful
+    submit behaviour: the first successful call returns unchanged. On failure, a
+    structured cause code is emitted; by default one retry is attempted after a
+    short jitter to absorb transient submit errors.
+    """
+    if not callable(submit_callable):
+        exc = TypeError("submit_callable must be callable")
+        log_structured_agent_error("agent.submit:invalid_callable", exc)
+        raise exc
+
+    attempts = max(0, int(retries)) + 1
+    last_exc = None
+    for attempt in range(1, attempts + 1):
+        try:
+            result = submit_callable(*args, **kwargs)
+            if attempt > 1:
+                LOGGER.info(
+                    "agent_submit_retry_succeeded attempt=%s max_attempts=%s",
+                    attempt,
+                    attempts,
+                )
+            return result
+        except Exception as exc:  # pragma: no cover - exercised by integration paths
+            last_exc = exc
+            payload = log_structured_agent_error(
+                "agent.submit:fail",
+                exc,
+                attempt=attempt,
+                max_attempts=attempts,
+            )
+            if attempt >= attempts:
+                LOGGER.error(
+                    "agent_submit_exhausted_retries %s",
+                    json.dumps(payload, sort_keys=True),
+                )
+                raise
+            time.sleep(random.uniform(0, max(0.0, float(jitter_seconds))))
+
+    # Defensive fallback: the loop should always return or raise.
+    raise last_exc
+
