--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,41 @@
+import json
+import logging
+import random
+import time
+
+
+logger = logging.getLogger(__name__)
+
+
+def log_structured_error(cause_code, error, **context):
+    """Emit a machine-readable error record for agent failure paths."""
+    logger.error(
+        json.dumps(
+            {
+                "event": "agent.error",
+                "cause_code": cause_code,
+                "error_type": type(error).__name__,
+                "error": str(error),
+                "context": context,
+            },
+            sort_keys=True,
+        )
+    )
+
+
+def retry_once_with_jitter(operation, *, cause_code, jitter_seconds=0.25, **context):
+    """Run an operation, retrying once after jitter while preserving structured errors."""
+    try:
+        return operation()
+    except Exception as first_error:
+        log_structured_error(cause_code, first_error, attempt=1, **context)
+        time.sleep(random.uniform(0, jitter_seconds))
+        try:
+            return operation()
+        except Exception as second_error:
+            log_structured_error(cause_code, second_error, attempt=2, **context)
+            raise
+
+
