--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,80 @@
+import logging
+import random
+import time
+
+
+logger = logging.getLogger(__name__)
+
+
+def _log_structured_error(cause_code, exc, **context):
+    """Emit a structured error record for submit/tool-call failures.
+
+    Reflection showed `agent.submit:fail` as the highest-intensity thorn.  Keep
+    the payload intentionally small and JSON-like so log collectors can group by
+    `cause_code` without depending on traceback text.
+    """
+    logger.error(
+        "agent_error",
+        extra={
+            "cause_code": cause_code,
+            "error_type": type(exc).__name__,
+            "error": str(exc),
+            "context": context,
+        },
+        exc_info=True,
+    )
+
+
+def _call_with_one_retry(operation, *, cause_code, jitter_seconds=0.25, **context):
+    """Run `operation`, retrying once with jitter after a structured log.
+
+    This preserves successful paths while hardening transient failures.  The
+    original exception is re-raised if the retry also fails.
+    """
+    try:
+        return operation()
+    except Exception as first_error:
+        _log_structured_error(cause_code, first_error, attempt=1, **context)
+        time.sleep(random.uniform(0, jitter_seconds))
+        try:
+            return operation()
+        except Exception as retry_error:
+            _log_structured_error(cause_code, retry_error, attempt=2, **context)
+            raise
+
+
+def submit_with_observability(submit_callable, *args, **kwargs):
+    """Invoke an agent submit callable with structured logging and one retry.
+
+    Use this wrapper at submit call sites instead of calling the submit function
+    directly.  It addresses the observed `agent.submit:fail` thorn while keeping
+    existing successful submit behavior unchanged.
+    """
+    return _call_with_one_retry(
+        lambda: submit_callable(*args, **kwargs),
+        cause_code="agent.submit.fail",
+        operation=getattr(submit_callable, "__name__", "submit"),
+    )
+
