--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,58 @@
+import json
+import logging
+import random
+import time
+
+logger = logging.getLogger(__name__)
+
+
+def _log_structured_event(event, *, cause, status, **fields):
+    """Emit a machine-readable log record for agent submit observability."""
+    payload = {
+        "event": event,
+        "cause": cause,
+        "status": status,
+        **fields,
+    }
+    logger.info("agent_event %s", json.dumps(payload, sort_keys=True, default=str))
+
+
+def _submit_with_observability(submit_func, *args, **kwargs):
+    """Run agent.submit with structured errors and one jittered retry.
+
+    Recent logs showed an `agent.submit:fail` thorn.  This wrapper preserves the
+    existing submit behavior on success while making failures diagnosable and
+    giving transient errors one bounded retry.
+    """
+    max_attempts = 2
+    for attempt in range(1, max_attempts + 1):
+        started = time.monotonic()
+        try:
+            result = submit_func(*args, **kwargs)
+            _log_structured_event(
+                "agent.submit",
+                cause="agent.submit:ok",
+                status="ok",
+                attempt=attempt,
+                elapsed_ms=round((time.monotonic() - started) * 1000, 2),
+            )
+            return result
+        except Exception as exc:
+            elapsed_ms = round((time.monotonic() - started) * 1000, 2)
+            _log_structured_event(
+                "agent.submit",
+                cause="agent.submit:fail",
+                status="error",
+                attempt=attempt,
+                elapsed_ms=elapsed_ms,
+                error_type=type(exc).__name__,
+                error=str(exc),
+            )
+            if attempt >= max_attempts:
+                raise
+            time.sleep(random.uniform(0.05, 0.25))
+
