diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@
+def submit_with_observability(submit_func, *args, **kwargs):
+    """Submit with structured failure telemetry and a single jittered retry.
+
+    Recent RBT diagnostics identified ``agent.submit`` failures as the top
+    thorn.  Keep the existing submit behavior intact by accepting the current
+    callable as ``submit_func``, but harden the failure path with cause-coded
+    logging and one retry.  Call sites can wrap their existing submit call as:
+
+        submit_with_observability(agent.submit, payload)
+
+    The function intentionally uses local imports so it can be added safely to
+    the existing module without requiring import-block surgery.
+    """
+    import json
+    import logging
+    import random
+    import time
+
+    logger = logging.getLogger(__name__)
+    cause_code = "agent.submit:fail"
+
+    try:
+        return submit_func(*args, **kwargs)
+    except Exception as exc:
+        logger.warning(
+            json.dumps(
+                {
+                    "event": "agent.submit.retry",
+                    "cause": cause_code,
+                    "attempt": 1,
+                    "error_type": type(exc).__name__,
+                    "error": str(exc),
+                },
+                sort_keys=True,
+            )
+        )
+        time.sleep(random.uniform(0.05, 0.25))
+        try:
+            return submit_func(*args, **kwargs)
+        except Exception as retry_exc:
+            logger.error(
+                json.dumps(
+                    {
+                        "event": "agent.submit.failed",
+                        "cause": cause_code,
+                        "attempt": 2,
+                        "error_type": type(retry_exc).__name__,
+                        "error": str(retry_exc),
+                    },
+                    sort_keys=True,
+                )
+            )
+            raise
