diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,88 @@
+import functools
+import json
+import logging
+import random
+import time
+
+logger = logging.getLogger(__name__)
+
+
+class AgentSubmitError(RuntimeError):
+    """Raised when agent.submit fails after the guarded retry path."""
+
+    def __init__(self, message, *, cause_code="agent.submit:fail", attempts=0):
+        super().__init__(message)
+        self.cause_code = cause_code
+        self.attempts = attempts
+
+
+def _safe_json(value):
+    """Return a JSON-serialisable value for structured diagnostic logging."""
+    try:
+        json.dumps(value)
+        return value
+    except TypeError:
+        return repr(value)
+
+
+def _log_agent_submit_event(status, *, attempt, max_attempts, error=None, **fields):
+    """Emit structured observability for agent.submit successes and failures."""
+    payload = {
+        "event": "agent.submit",
+        "status": status,
+        "cause_code": "agent.submit:fail" if status == "fail" else "agent.submit:ok",
+        "attempt": attempt,
+        "max_attempts": max_attempts,
+        **{key: _safe_json(value) for key, value in fields.items()},
+    }
+    if error is not None:
+        payload["error_type"] = type(error).__name__
+        payload["error"] = str(error)
+    logger.info("agent_submit_event %s", json.dumps(payload, sort_keys=True))
+
+
+def retry_agent_submit_once(func=None, *, jitter_seconds=0.25):
+    """Wrap agent.submit-like calls with one jittered retry and structured errors.
+
+    The RBT review identified agent.submit:fail as the top thorn. This decorator
+    keeps the successful path unchanged while adding observability and one bounded
+    retry so transient submit failures are surfaced with a stable cause code.
+    """
+
+    def decorate(submit_func):
+        @functools.wraps(submit_func)
+        def wrapper(*args, **kwargs):
+            max_attempts = 2
+            last_error = None
+            for attempt in range(1, max_attempts + 1):
+                try:
+                    result = submit_func(*args, **kwargs)
+                    _log_agent_submit_event("ok", attempt=attempt, max_attempts=max_attempts)
+                    return result
+                except Exception as exc:  # pragma: no cover - preserves original exception detail in logs
+                    last_error = exc
+                    _log_agent_submit_event(
+                        "fail",
+                        attempt=attempt,
+                        max_attempts=max_attempts,
+                        error=exc,
+                    )
+                    if attempt >= max_attempts:
+                        raise AgentSubmitError(
+                            "agent.submit failed after retry",
+                            attempts=attempt,
+                        ) from exc
+                    time.sleep(random.uniform(0, jitter_seconds))
+            raise AgentSubmitError(
+                "agent.submit failed without returning a result",
+                attempts=max_attempts,
+            ) from last_error
+
+        return wrapper
+
+    if func is not None:
+        return decorate(func)
+    return decorate
+
