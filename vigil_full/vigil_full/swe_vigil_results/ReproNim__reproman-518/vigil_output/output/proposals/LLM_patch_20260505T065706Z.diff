--- a/agent.py
+++ b/agent.py
@@ -1,6 +1,62 @@
+import functools
+import json
+import logging
+import random
+import time
+
+logger = logging.getLogger(__name__)
+
+
+def _structured_submit_error(exc, *, attempt, max_attempts, cause_code="agent.submit:fail"):
+    """Return a structured, machine-readable submit failure payload."""
+    return {
+        "cause_code": cause_code,
+        "attempt": attempt,
+        "max_attempts": max_attempts,
+        "exception_type": type(exc).__name__,
+        "message": str(exc),
+    }
+
+
+def retry_submit_once(func):
+    """Retry agent.submit-like calls once and log structured failure details.
+
+    The RBT loop identified agent.submit failures as the top thorn.  This
+    decorator keeps successful submit behavior unchanged while adding one
+    jittered retry and cause-coded logging on failures.
+    """
+
+    @functools.wraps(func)
+    def wrapper(*args, **kwargs):
+        max_attempts = 2
+        last_error = None
+        for attempt in range(1, max_attempts + 1):
+            try:
+                return func(*args, **kwargs)
+            except Exception as exc:
+                last_error = exc
+                payload = _structured_submit_error(
+                    exc,
+                    attempt=attempt,
+                    max_attempts=max_attempts,
+                )
+                logger.error("agent_submit_failed %s", json.dumps(payload, sort_keys=True))
+                if attempt < max_attempts:
+                    time.sleep(random.uniform(0.05, 0.25))
+                    continue
+        raise last_error
+
+
+def observe_submit_result(result):
+    """Log successful submit outcomes without changing the returned value."""
+    logger.info(
+        "agent_submit_ok %s",
+        json.dumps({"cause_code": "agent.submit:ok", "result_type": type(result).__name__}, sort_keys=True),
+    )
+    return result
+
