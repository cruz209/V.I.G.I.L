+"""Agent reliability helpers.
+
+This module provides a small, dependency-free observability and retry wrapper
+for submission paths. Recent RBT diagnostics identified ``agent.submit`` as a
+thorn; callers can route submit callables through ``submit_with_observability``
+to emit structured cause-coded errors and retry transient failures once.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import random
+import time
+from collections.abc import Callable
+from typing import Any, TypeVar
+
+
+LOGGER = logging.getLogger(__name__)
+T = TypeVar("T")
+
+
+class AgentSubmitError(RuntimeError):
+    """Raised when an agent submit operation fails after retry."""
+
+    def __init__(self, message: str, *, cause_code: str, attempts: int) -> None:
+        super().__init__(message)
+        self.cause_code = cause_code
+        self.attempts = attempts
+
+
+def _structured_log(level: int, event: str, **fields: Any) -> None:
+    """Emit a structured JSON log line with stable field names."""
+    payload = {"event": event, **fields}
+    LOGGER.log(level, json.dumps(payload, sort_keys=True, default=str))
+
+
+def submit_with_observability(
+    submit_func: Callable[..., T],
+    *args: Any,
+    cause_code: str = "agent.submit",
+    max_attempts: int = 2,
+    base_delay_seconds: float = 0.2,
+    jitter_seconds: float = 0.15,
+    **kwargs: Any,
+) -> T:
+    """Run a submit callable with structured logging and one jittered retry.
+
+    Args:
+        submit_func: Callable that performs the actual submission.
+        *args: Positional arguments forwarded to ``submit_func``.
+        cause_code: Stable cause code included in success/failure logs.
+        max_attempts: Total attempts, including the first try. Defaults to two
+            attempts to satisfy the RBT mitigation of retrying once.
+        base_delay_seconds: Base sleep before retry.
+        jitter_seconds: Maximum random jitter added to the base delay.
+        **kwargs: Keyword arguments forwarded to ``submit_func``.
+
+    Returns:
+        The return value from ``submit_func``.
+
+    Raises:
+        AgentSubmitError: If every attempt fails. The original exception is
+            chained as ``__cause__``.
+    """
+    if max_attempts < 1:
+        raise ValueError("max_attempts must be at least 1")
+    if base_delay_seconds < 0:
+        raise ValueError("base_delay_seconds must be non-negative")
+    if jitter_seconds < 0:
+        raise ValueError("jitter_seconds must be non-negative")
+
+    last_error: Exception | None = None
+    for attempt in range(1, max_attempts + 1):
+        started = time.monotonic()
+        try:
+            result = submit_func(*args, **kwargs)
+        except Exception as exc:  # pragma: no cover - preserves original error chain
+            last_error = exc
+            elapsed_ms = int((time.monotonic() - started) * 1000)
+            _structured_log(
+                logging.ERROR,
+                "agent_submit_failed",
+                cause_code=f"{cause_code}:fail",
+                attempt=attempt,
+                max_attempts=max_attempts,
+                elapsed_ms=elapsed_ms,
+                error_type=type(exc).__name__,
+                error=str(exc),
+                will_retry=attempt < max_attempts,
+            )
+            if attempt >= max_attempts:
+                break
+            time.sleep(base_delay_seconds + random.uniform(0, jitter_seconds))
+        else:
+            elapsed_ms = int((time.monotonic() - started) * 1000)
+            _structured_log(
+                logging.INFO,
+                "agent_submit_succeeded",
+                cause_code=f"{cause_code}:ok",
+                attempt=attempt,
+                elapsed_ms=elapsed_ms,
+            )
+            return result
+
+    raise AgentSubmitError(
+        "agent submit failed after retry",
+        cause_code=f"{cause_code}:fail",
+        attempts=max_attempts,
+    ) from last_error
