diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,55 @@
+import json
+import logging
+import random
+import time
+
+LOGGER = logging.getLogger(__name__)
+
+
+def _log_structured_event(event, **fields):
+    """Emit machine-readable agent events without disrupting normal flow."""
+    payload = {"event": event, **fields}
+    LOGGER.info(json.dumps(payload, sort_keys=True, default=str))
+
+
+def submit_with_observability(submit_callable, *args, retries=1, jitter_seconds=0.25, **kwargs):
+    """Run an agent.submit-style callable with structured logging and one retry.
+
+    The recent RBT diagnosis identified ``agent.submit:fail`` as the top thorn.
+    This wrapper preserves existing successful submit behavior while ensuring
+    failures include cause codes and get a bounded retry before surfacing.
+    """
+    attempts = retries + 1
+    for attempt in range(1, attempts + 1):
+        try:
+            result = submit_callable(*args, **kwargs)
+            _log_structured_event(
+                "agent.submit.ok",
+                cause="agent.submit:ok",
+                attempt=attempt,
+                attempts=attempts,
+            )
+            return result
+        except Exception as exc:
+            _log_structured_event(
+                "agent.submit.fail",
+                cause="agent.submit:fail",
+                attempt=attempt,
+                attempts=attempts,
+                error_type=type(exc).__name__,
+                error=str(exc),
+            )
+            if attempt >= attempts:
+                raise
+            time.sleep(random.uniform(0, jitter_seconds))
+
