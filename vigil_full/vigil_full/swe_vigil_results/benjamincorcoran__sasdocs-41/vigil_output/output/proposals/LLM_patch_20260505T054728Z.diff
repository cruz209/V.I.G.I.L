@@ -0,0 +1,93 @@
+"""Agent reliability helpers.
+
+This module provides a small structured-observability wrapper for submit-style
+operations.  It is intentionally dependency-light so it can be used by existing
+agent code without changing successful behavior.
+"""
+
+from __future__ import annotations
+
+import logging
+import random
+import time
+from typing import Any, Callable, Optional, TypeVar
+
+
+T = TypeVar("T")
+
+
+LOGGER = logging.getLogger(__name__)
+
+
+class AgentSubmitError(RuntimeError):
+    """Raised when an agent submit operation fails after retry."""
+
+    def __init__(self, message: str, *, cause_code: str, attempts: int) -> None:
+        super().__init__(message)
+        self.cause_code = cause_code
+        self.attempts = attempts
+
+
+def _safe_len(value: Any) -> Optional[int]:
+    """Return len(value) when available without risking a secondary failure."""
+
+    try:
+        return len(value)  # type: ignore[arg-type]
+    except Exception:
+        return None
+
+
+def log_agent_event(
+    *,
+    event: str,
+    cause_code: str,
+    attempt: int = 1,
+    status: str = "info",
+    **fields: Any,
+) -> None:
+    """Emit a structured log record for agent submit observability.
+
+    The event schema is stable on purpose so downstream log processors can group
+    failures by ``cause_code``.  This directly addresses the observed
+    ``agent.submit:fail`` thorn while preserving successful execution paths.
+    """
+
+    payload = {
+        "event": event,
+        "cause_code": cause_code,
+        "attempt": attempt,
+        "status": status,
+        **fields,
+    }
+
+    if status == "error":
+        LOGGER.error("agent_event", extra={"agent_event": payload})
+    elif status == "warning":
+        LOGGER.warning("agent_event", extra={"agent_event": payload})
+    else:
+        LOGGER.info("agent_event", extra={"agent_event": payload})
+
+
+def submit_with_observability(
+    submit_fn: Callable[..., T],
+    *args: Any,
+    cause_code: str = "agent.submit",
+    retry_once: bool = True,
+    jitter_seconds: float = 0.25,
+    **kwargs: Any,
+) -> T:
+    """Run a submit callable with structured logging and one jittered retry.
+
+    Existing callers can wrap their submit operation as::
+
+        result = submit_with_observability(agent.submit, payload)
+
+    Successful calls return exactly what ``submit_fn`` returns.  Failed calls are
+    logged with a stable cause code and retried once before surfacing a
+    structured ``AgentSubmitError``.
+    """
+
+    max_attempts = 2 if retry_once else 1
+    last_error: Optional[BaseException] = None
+
+    for attempt in range(1, max_attempts + 1):
+        try:
+            result = submit_fn(*args, **kwargs)
+            log_agent_event(
+                event="agent.submit",
+                cause_code=f"{cause_code}:ok",
+                attempt=attempt,
+                status="info",
+                arg_count=len(args),
+                kwarg_count=len(kwargs),
+                result_size=_safe_len(result),
+            )
+            return result
+        except Exception as exc:  # pragma: no cover - exercised by integrations
+            last_error = exc
+            log_agent_event(
+                event="agent.submit",
+                cause_code=f"{cause_code}:fail",
+                attempt=attempt,
+                status="warning" if attempt < max_attempts else "error",
+                error_type=type(exc).__name__,
+                error_message=str(exc),
+            )
+            if attempt < max_attempts:
+                time.sleep(random.uniform(0.0, max(jitter_seconds, 0.0)))
+
+    raise AgentSubmitError(
+        "agent submit failed after retry",
+        cause_code=f"{cause_code}:fail",
+        attempts=max_attempts,
+    ) from last_error
