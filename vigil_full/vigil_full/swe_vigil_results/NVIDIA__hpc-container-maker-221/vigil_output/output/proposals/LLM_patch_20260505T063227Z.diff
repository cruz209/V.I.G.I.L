--- a/agent.py
+++ b/agent.py
@@ -0,0 +1,88 @@
+"""Agent reliability helpers.
+
+This module contains small, dependency-free utilities used by the agent runtime
+to make submission failures observable and retryable.  They are intentionally
+standalone so existing call sites can opt in without changing successful paths.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import random
+import time
+from dataclasses import dataclass
+from typing import Any, Callable, Dict, Optional, TypeVar
+
+
+LOGGER = logging.getLogger(__name__)
+T = TypeVar("T")
+
+
+@dataclass(frozen=True)
+class StructuredAgentError:
+    """Serializable description of an agent failure."""
+
+    cause_code: str
+    message: str
+    operation: str
+    attempt: int
+    retryable: bool
+    exception_type: str
+
+    def as_dict(self) -> Dict[str, Any]:
+        return {
+            "cause_code": self.cause_code,
+            "message": self.message,
+            "operation": self.operation,
+            "attempt": self.attempt,
+            "retryable": self.retryable,
+            "exception_type": self.exception_type,
+        }
+
+
+def log_structured_agent_error(error: StructuredAgentError) -> None:
+    """Emit structured error logging for failing agent paths."""
+
+    LOGGER.error("agent_error=%s", json.dumps(error.as_dict(), sort_keys=True))
+
+
+def retry_once_with_jitter(
+    operation: str,
+    func: Callable[[], T],
+    *,
+    cause_code: str,
+    base_delay_seconds: float = 0.25,
+    jitter_seconds: float = 0.25,
+) -> T:
+    """Run *func*, retrying one time with jitter on failure.
+
+    The helper preserves successful behavior while hardening thorny paths such
+    as ``agent.submit``.  On each failure it logs a structured record with a
+    stable cause code so future RBT diagnosis can group failures reliably.
+    """
+
+    last_error: Optional[BaseException] = None
+    for attempt in (1, 2):
+        try:
+            return func()
+        except Exception as exc:  # pragma: no cover - defensive boundary
+            last_error = exc
+            retryable = attempt == 1
+            log_structured_agent_error(
+                StructuredAgentError(
+                    cause_code=cause_code,
+                    message=str(exc),
+                    operation=operation,
+                    attempt=attempt,
+                    retryable=retryable,
+                    exception_type=exc.__class__.__name__,
+                )
+            )
+            if not retryable:
+                break
+            delay = base_delay_seconds + random.uniform(0.0, jitter_seconds)
+            time.sleep(delay)
+
+    assert last_error is not None
+    raise last_error
+
+
+def submit_with_observability(submit: Callable[[], T]) -> T:
+    """Wrap an agent.submit callable with structured logging and one retry."""
+
+    return retry_once_with_jitter(
+        "agent.submit",
+        submit,
+        cause_code="agent.submit:fail",
+    )
