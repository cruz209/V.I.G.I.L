+"""Agent runtime helpers.
+
+This module now includes structured submit observability and a single retry
+path for transient submit failures.  The helper is intentionally dependency
+light so it can be adopted by existing agent.submit call sites without changing
+their success-path behavior.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import random
+import time
+from typing import Any, Callable, Optional
+
+
+LOGGER = logging.getLogger(__name__)
+
+
+def _json_safe(value: Any) -> str:
+    """Return a stable JSON representation for structured log payloads."""
+    try:
+        return json.dumps(value, sort_keys=True, default=str)
+    except Exception:
+        return repr(value)
+
+
+def log_structured_error(
+    *,
+    cause_code: str,
+    message: str,
+    exc: Optional[BaseException] = None,
+    **context: Any,
+) -> None:
+    """Emit a structured error event with a cause code.
+
+    RBT evidence showed an ``agent.submit:fail`` thorn.  This logger makes that
+    failure mode diagnosable while preserving the successful submit behavior.
+    """
+    payload = {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "message": message,
+        "context": context,
+    }
+    if exc is not None:
+        payload["exception_type"] = type(exc).__name__
+        payload["exception"] = str(exc)
+
+    LOGGER.error(_json_safe(payload), exc_info=exc is not None)
+
+
+def submit_with_observability(
+    submit_fn: Callable[..., Any],
+    *args: Any,
+    cause_code: str = "agent.submit:fail",
+    max_retries: int = 1,
+    base_jitter_seconds: float = 0.25,
+    **kwargs: Any,
+) -> Any:
+    """Call ``submit_fn`` with structured failure logging and one jittered retry.
+
+    The first attempt remains unchanged.  On failure, the exception is logged
+    with a machine-readable cause code, then retried once after a short jittered
+    delay.  If the retry fails, the final exception is surfaced to the caller.
+    """
+    if max_retries < 0:
+        raise ValueError("max_retries must be >= 0")
+    if base_jitter_seconds < 0:
+        raise ValueError("base_jitter_seconds must be >= 0")
+
+    attempt = 0
+    while True:
+        try:
+            result = submit_fn(*args, **kwargs)
+            if attempt:
+                LOGGER.info(
+                    _json_safe(
+                        {
+                            "event": "agent.submit.retry_recovered",
+                            "cause_code": cause_code,
+                            "attempt": attempt + 1,
+                        }
+                    )
+                )
+            return result
+        except Exception as exc:
+            log_structured_error(
+                cause_code=cause_code,
+                message="agent submit attempt failed",
+                exc=exc,
+                attempt=attempt + 1,
+                retries_remaining=max_retries - attempt,
+            )
+            if attempt >= max_retries:
+                raise
+
+            sleep_for = random.uniform(0, base_jitter_seconds)
+            time.sleep(sleep_for)
+            attempt += 1
