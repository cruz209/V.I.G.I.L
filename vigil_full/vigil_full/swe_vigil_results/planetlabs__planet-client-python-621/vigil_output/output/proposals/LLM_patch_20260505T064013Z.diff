diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,77 @@
+import functools
+import json
+import logging
+import random
+import time
+
+_agent_logger = logging.getLogger(__name__)
+
+
+def _log_structured_error(cause_code, error, **context):
+    """Emit a structured error record for agent failure paths.
+
+    The recent RBT diagnosis identified `agent.submit:fail` as the primary
+    thorn.  This helper standardizes failure telemetry so future log reviews
+    can distinguish transient submit failures from validation or integration
+    defects without changing successful behavior.
+    """
+    payload = {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "error_type": type(error).__name__,
+        "error": str(error),
+    }
+    payload.update(context)
+    _agent_logger.error(json.dumps(payload, sort_keys=True))
+
+
+def retry_once_with_jitter(cause_code, min_delay=0.05, max_delay=0.25):
+    """Retry a wrapped operation once and log structured failure details.
+
+    Intended for submit/tool-call boundaries where a single transient failure
+    should be retried once before surfacing the original exception class to the
+    caller.  Successful first attempts are returned unchanged.
+    """
+    if min_delay < 0 or max_delay < min_delay:
+        raise ValueError("invalid jitter range")
+
+    def decorator(func):
+        @functools.wraps(func)
+        def wrapper(*args, **kwargs):
+            try:
+                return func(*args, **kwargs)
+            except Exception as first_error:
+                _log_structured_error(
+                    cause_code,
+                    first_error,
+                    attempt=1,
+                    action="retrying_once",
+                    function=getattr(func, "__name__", "<unknown>"),
+                )
+                time.sleep(random.uniform(min_delay, max_delay))
+                try:
+                    return func(*args, **kwargs)
+                except Exception as second_error:
+                    _log_structured_error(
+                        cause_code,
+                        second_error,
+                        attempt=2,
+                        action="raising",
+                        function=getattr(func, "__name__", "<unknown>"),
+                    )
+                    raise
+
+        return wrapper
+
+    return decorator
+
