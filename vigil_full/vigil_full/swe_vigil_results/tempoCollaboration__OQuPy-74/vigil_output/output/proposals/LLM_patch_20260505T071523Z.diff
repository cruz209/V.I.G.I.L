diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,79 @@
+import json
+import logging
+import random
+import time
+
+LOGGER = logging.getLogger(__name__)
+
+
+class AgentSubmitError(RuntimeError):
+    """Raised when an agent.submit operation fails after retry."""
+
+
+def _structured_error_log(cause_code, error, **context):
+    """Emit structured failure telemetry with a stable cause code.
+
+    Recent RBT diagnosis identified `agent.submit:fail` as the top thorn.
+    Keeping this helper small and dependency-free ensures every failing submit
+    path can report the same fields without changing successful behaviour.
+    """
+    payload = {
+        "event": "agent.submit.failure",
+        "cause_code": cause_code,
+        "error_type": type(error).__name__,
+        "error": str(error),
+    }
+    payload.update({k: v for k, v in context.items() if v is not None})
+    LOGGER.error(json.dumps(payload, sort_keys=True))
+
+
+def submit_with_observability(submit_callable, *args, retry_once=True, **kwargs):
+    """Call agent.submit with structured error logging and one jittered retry.
+
+    Args:
+        submit_callable: Callable that performs the underlying submit.
+        *args: Positional arguments forwarded to submit_callable.
+        retry_once: When true, retry once after a small jittered delay.
+        **kwargs: Keyword arguments forwarded to submit_callable.
+
+    Returns:
+        The return value of submit_callable.
+
+    Raises:
+        AgentSubmitError: if the initial call and optional retry fail.
+    """
+    try:
+        result = submit_callable(*args, **kwargs)
+        LOGGER.info(
+            json.dumps(
+                {"event": "agent.submit.success", "attempt": 1},
+                sort_keys=True,
+            )
+        )
+        return result
+    except Exception as first_error:
+        _structured_error_log(
+            "agent.submit:fail",
+            first_error,
+            attempt=1,
+            retry_scheduled=bool(retry_once),
+        )
+        if not retry_once:
+            raise AgentSubmitError("agent.submit failed") from first_error
+
+    delay_seconds = random.uniform(0.05, 0.25)
+    time.sleep(delay_seconds)
+    try:
+        result = submit_callable(*args, **kwargs)
+        LOGGER.info(
+            json.dumps(
+                {
+                    "event": "agent.submit.success",
+                    "attempt": 2,
+                    "retry_delay_seconds": round(delay_seconds, 3),
+                },
+                sort_keys=True,
+            )
+        )
+        return result
+    except Exception as second_error:
+        _structured_error_log(
+            "agent.submit:fail",
+            second_error,
+            attempt=2,
+            retry_scheduled=False,
+        )
+        raise AgentSubmitError("agent.submit failed after retry") from second_error
+
