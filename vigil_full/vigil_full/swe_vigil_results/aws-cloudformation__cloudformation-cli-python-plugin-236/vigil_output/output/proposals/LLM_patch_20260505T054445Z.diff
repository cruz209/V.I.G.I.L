--- a/agent.py
+++ b/agent.py
@@ -1,0 +1,74 @@
+import json
+import logging
+import random
+import time
+from functools import wraps
+
+
+LOGGER = logging.getLogger(__name__)
+
+
+def _structured_agent_error(cause_code, exc, *, attempt=None, max_attempts=None, extra=None):
+    """Log a machine-readable agent failure event without hiding the original error."""
+    payload = {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "error_type": type(exc).__name__,
+        "error": str(exc),
+    }
+    if attempt is not None:
+        payload["attempt"] = attempt
+    if max_attempts is not None:
+        payload["max_attempts"] = max_attempts
+    if extra:
+        payload.update(extra)
+    LOGGER.error("agent_failure %s", json.dumps(payload, sort_keys=True), exc_info=True)
+
+
+def retry_once_with_jitter(cause_code, *, base_delay=0.2, jitter=0.15):
+    """Retry a transient agent operation once and emit structured failure logs.
+
+    The recent RBT diagnosis identified ``agent.submit`` as the top thorn. This
+    decorator gives submit-like tool calls a consistent mitigation: log the
+    first failure with a cause code, wait briefly with jitter, retry once, and
+    surface the final failure with structured context if it still fails.
+    """
+    def decorator(func):
+        @wraps(func)
+        def wrapper(*args, **kwargs):
+            max_attempts = 2
+            for attempt in range(1, max_attempts + 1):
+                try:
+                    return func(*args, **kwargs)
+                except Exception as exc:
+                    _structured_agent_error(
+                        cause_code,
+                        exc,
+                        attempt=attempt,
+                        max_attempts=max_attempts,
+                        extra={"operation": getattr(func, "__name__", "unknown")},
+                    )
+                    if attempt >= max_attempts:
+                        raise
+                    time.sleep(base_delay + random.uniform(0, jitter))
+        return wrapper
+    return decorator
+
+
+def submit_with_observability(submit_callable, *args, **kwargs):
+    """Run an agent submit callable with one retry and structured observability.
+
+    Use this helper at agent.submit call sites when direct decoration is not
+    practical. It preserves successful behavior while making failures visible
+    as ``agent.submit:fail`` events and retrying once for transient issues.
+    """
+    @retry_once_with_jitter("agent.submit:fail")
+    def _submit():
+        return submit_callable(*args, **kwargs)
+
+    return _submit()
