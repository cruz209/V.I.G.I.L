--- a/agent.py
+++ b/agent.py
@@ -1,0 +2,79 @@
+import json
+import logging
+import random
+import time
+from typing import Any, Callable, Dict, Optional, Tuple, TypeVar
+
+
+_SubmitResult = TypeVar("_SubmitResult")
+_LOGGER = logging.getLogger(__name__)
+
+
+def _structured_log(level: int, event: str, **fields: Any) -> None:
+    """Emit machine-readable logs for agent reliability diagnostics.
+
+    RBT analysis identified ``agent.submit:fail`` as the current thorn.  Keeping
+    the log payload flat and JSON-serialisable makes failures searchable without
+    changing successful behaviour.
+    """
+    payload: Dict[str, Any] = {"event": event, **fields}
+    try:
+        message = json.dumps(payload, sort_keys=True, default=str)
+    except TypeError:
+        payload = {key: str(value) for key, value in payload.items()}
+        message = json.dumps(payload, sort_keys=True)
+    _LOGGER.log(level, message)
+
+
+def submit_with_observability(
+    submit_fn: Callable[..., _SubmitResult],
+    *args: Any,
+    cause_code: str = "agent.submit",
+    retries: int = 1,
+    jitter_range: Tuple[float, float] = (0.05, 0.25),
+    context: Optional[Dict[str, Any]] = None,
+    **kwargs: Any,
+) -> _SubmitResult:
+    """Call an agent submit function with structured errors and one retry.
+
+    This helper preserves the existing successful path while hardening the
+    failing path observed in logs.  On failure it records a cause code, retries
+    once with bounded jitter, and re-raises the final exception so callers retain
+    their current error semantics.
+    """
+    if retries < 0:
+        raise ValueError("retries must be non-negative")
+
+    metadata = dict(context or {})
+    attempt = 0
+    while True:
+        try:
+            result = submit_fn(*args, **kwargs)
+            if attempt:
+                _structured_log(
+                    logging.INFO,
+                    "agent.submit.retry_recovered",
+                    cause_code=cause_code,
+                    attempt=attempt + 1,
+                    **metadata,
+                )
+            return result
+        except Exception as exc:
+            is_final = attempt >= retries
+            _structured_log(
+                logging.ERROR if is_final else logging.WARNING,
+                "agent.submit.fail",
+                cause_code=cause_code,
+                attempt=attempt + 1,
+                retrying=not is_final,
+                error_type=type(exc).__name__,
+                error=str(exc),
+                **metadata,
+            )
+            if is_final:
+                raise
+            sleep_for = random.uniform(*jitter_range)
+            time.sleep(sleep_for)
+            attempt += 1
+
