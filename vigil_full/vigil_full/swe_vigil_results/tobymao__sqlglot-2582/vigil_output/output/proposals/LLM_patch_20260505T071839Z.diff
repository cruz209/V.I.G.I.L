diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,76 @@
+import json
+import logging
+import random
+import time
+
+
+LOGGER = logging.getLogger(__name__)
+
+
+def log_structured_error(cause_code, error, **context):
+    """Emit machine-readable error details for agent failure paths.
+
+    Recent RBT diagnosis identified ``agent.submit:fail`` as the top thorn.
+    Keeping this helper centralized makes submit failures visible without
+    changing successful shell execution behavior.
+    """
+    payload = {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "error_type": type(error).__name__,
+        "error": str(error),
+        "context": context,
+    }
+    LOGGER.error(json.dumps(payload, sort_keys=True))
+
+
+def submit_with_retry(submit_func, *args, retries=1, jitter_seconds=0.25, **kwargs):
+    """Call an agent submit function with one jittered retry and structured logs.
+
+    Use this wrapper around existing ``agent.submit`` call sites so transient
+    submit failures are retried once and persistent failures include a stable
+    cause code for downstream log diagnosis.
+    """
+    attempt = 0
+    while True:
+        try:
+            return submit_func(*args, **kwargs)
+        except Exception as exc:
+            log_structured_error(
+                "agent.submit:fail",
+                exc,
+                attempt=attempt,
+                max_retries=retries,
+                submit_func=getattr(submit_func, "__name__", repr(submit_func)),
+            )
+            if attempt >= retries:
+                raise
+            attempt += 1
+            time.sleep(random.uniform(0, jitter_seconds))
+
