--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,82 @@
+def _structured_agent_error(cause_code, error, **context):
+    """Return a stable, log-friendly error payload for agent failure paths."""
+    return {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "error_type": type(error).__name__,
+        "error": str(error),
+        "context": context,
+    }
+
+
+def submit_with_observability(submit_func, *args, retries=1, logger=None, cause_code="agent.submit", jitter_seconds=0.25, **kwargs):
+    """Call an agent submit function with structured logging and one retry.
+
+    This hardens the agent.submit thorn observed in recent logs without changing
+    successful behavior: the first successful result is returned unchanged. On
+    failure, a structured warning is emitted, the call is retried once by
+    default, and the final failure is logged with the same cause code before it
+    is re-raised to the caller.
+    """
+    import logging
+    import random
+    import time
+
+    log = logger or logging.getLogger(__name__)
+    attempts = max(1, int(retries) + 1)
+    last_error = None
+
+    for attempt in range(1, attempts + 1):
+        try:
+            return submit_func(*args, **kwargs)
+        except Exception as exc:
+            last_error = exc
+            payload = _structured_agent_error(
+                cause_code,
+                exc,
+                attempt=attempt,
+                attempts=attempts,
+                retrying=attempt < attempts,
+            )
+            log.warning("agent submit failed", extra={"agent_event": payload})
+            if attempt >= attempts:
+                break
+            if jitter_seconds:
+                time.sleep(random.uniform(0, float(jitter_seconds)))
+
+    final_payload = _structured_agent_error(
+        cause_code,
+        last_error,
+        attempt=attempts,
+        attempts=attempts,
+        retrying=False,
+    )
+    log.error("agent submit exhausted retries", extra={"agent_event": final_payload})
+    raise last_error
+
