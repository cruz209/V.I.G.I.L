diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,58 @@
+import functools
+import logging
+import random
+import time
+
+logger = logging.getLogger(__name__)
+
+
+def _log_agent_submit_event(status, *, cause_code, attempt, error=None):
+    """Emit structured observability for agent.submit outcomes.
+
+    Recent RBT diagnostics identified agent.submit failures as the top thorn.
+    Keep this helper small and dependency-free so submit paths can use it without
+    changing their behavior beyond better logging and one safe retry.
+    """
+    payload = {
+        "event": "agent.submit",
+        "status": status,
+        "cause_code": cause_code,
+        "attempt": attempt,
+    }
+    if error is not None:
+        payload["error_type"] = type(error).__name__
+        payload["error"] = str(error)
+    if status == "failed":
+        logger.error("agent.submit event", extra={"agent_event": payload})
+    else:
+        logger.info("agent.submit event", extra={"agent_event": payload})
+
+
+def submit_with_observability(submit_func, *args, max_retries=1, jitter_seconds=0.25, **kwargs):
+    """Call an agent.submit-like function with structured logging and one retry.
+
+    Args:
+        submit_func: Callable implementing the actual submit operation.
+        *args/**kwargs: Forwarded directly to submit_func.
+        max_retries: Number of retries after the initial attempt; defaults to 1.
+        jitter_seconds: Upper bound for random retry sleep; defaults to 250ms.
+
+    Returns:
+        Whatever submit_func returns.
+
+    Raises:
+        Re-raises the final exception after logging a structured failure event.
+    """
+    if not callable(submit_func):
+        raise TypeError("submit_func must be callable")
+
+    attempts = max(1, int(max_retries) + 1)
+    for attempt in range(1, attempts + 1):
+        try:
+            result = submit_func(*args, **kwargs)
+            _log_agent_submit_event("ok", cause_code="agent.submit:ok", attempt=attempt)
+            return result
+        except Exception as exc:
+            is_final_attempt = attempt >= attempts
+            _log_agent_submit_event(
+                "failed" if is_final_attempt else "retrying",
+                cause_code="agent.submit:fail",
+                attempt=attempt,
+                error=exc,
+            )
+            if is_final_attempt:
+                raise
+            time.sleep(random.uniform(0, max(0.0, float(jitter_seconds))))
+
