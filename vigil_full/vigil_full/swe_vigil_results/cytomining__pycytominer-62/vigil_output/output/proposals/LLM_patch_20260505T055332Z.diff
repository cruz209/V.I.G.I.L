--- a/agent.py
+++ b/agent.py
@@ -1,0 +1,93 @@
+import json
+import logging
+import random
+import time
+from typing import Any, Callable, Dict, Optional
+
+
+AGENT_OBSERVABILITY_LOGGER = logging.getLogger("agent.observability")
+
+
+def log_structured_event(
+    event: str,
+    *,
+    cause_code: str,
+    level: int = logging.INFO,
+    **fields: Any,
+) -> None:
+    """Emit machine-readable agent events with consistent cause codes.
+
+    Recent reflection identified `agent.submit:fail` as the primary thorn. This
+    helper keeps submit-path failures visible without changing successful shell
+    execution behavior.
+    """
+
+    payload: Dict[str, Any] = {
+        "event": event,
+        "cause_code": cause_code,
+        **fields,
+    }
+    AGENT_OBSERVABILITY_LOGGER.log(level, json.dumps(payload, sort_keys=True, default=str))
+
+
+def retry_once_with_jitter(
+    operation: Callable[[], Any],
+    *,
+    operation_name: str,
+    cause_code: str,
+    jitter_seconds: float = 0.25,
+) -> Any:
+    """Run an operation, retrying once after a small randomized delay.
+
+    Use this around submit/tool-call paths so transient failures are retried and
+    persistent failures surface as structured errors with clear cause codes.
+    """
+
+    try:
+        return operation()
+    except Exception as first_error:
+        delay = random.uniform(0, max(0.0, jitter_seconds))
+        log_structured_event(
+            "operation_retry_scheduled",
+            cause_code=cause_code,
+            level=logging.WARNING,
+            operation=operation_name,
+            error_type=type(first_error).__name__,
+            error=str(first_error),
+            retry_delay_seconds=round(delay, 3),
+        )
+        time.sleep(delay)
+
+    try:
+        result = operation()
+    except Exception as final_error:
+        log_structured_event(
+            "operation_failed_after_retry",
+            cause_code=cause_code,
+            level=logging.ERROR,
+            operation=operation_name,
+            error_type=type(final_error).__name__,
+            error=str(final_error),
+        )
+        raise
+
+    log_structured_event(
+        "operation_recovered_after_retry",
+        cause_code=cause_code,
+        level=logging.INFO,
+        operation=operation_name,
+    )
+    return result
+
+
+def submit_with_observability(
+    submit_fn: Callable[..., Any],
+    *args: Any,
+    cause_code: str = "agent.submit",
+    metadata: Optional[Dict[str, Any]] = None,
+    **kwargs: Any,
+) -> Any:
+    """Call an agent submit function with structured logging and one retry.
+
+    Existing submit call sites can wrap their callable with this helper to trim
+    the `agent.submit:fail` thorn while preserving current successful behavior.
+    """
+
+    meta = metadata or {}
+
+    def _call_submit() -> Any:
+        return submit_fn(*args, **kwargs)
+
+    return retry_once_with_jitter(
+        _call_submit,
+        operation_name="agent.submit",
+        cause_code=f"{cause_code}:fail",
+    )
