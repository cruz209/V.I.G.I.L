diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,64 @@
+import logging
+import random
+import time
+
+
+logger = logging.getLogger(__name__)
+
+
+class AgentSubmitError(RuntimeError):
+    """Raised when agent.submit fails after the retry budget is exhausted."""
+
+    def __init__(self, cause_code, original_error):
+        self.cause_code = cause_code
+        self.original_error = original_error
+        super().__init__(f"{cause_code}: {original_error}")
+
+
+def submit_with_observability(submit_callable, *args, **kwargs):
+    """Submit with one jittered retry and structured cause-code logging.
+
+    Recent RBT diagnosis identified `agent.submit:fail` as the top thorn.
+    This helper preserves the existing submit behavior on success while making
+    failures observable and retrying once before surfacing a structured error.
+    """
+    cause_code = "agent.submit"
+    max_attempts = 2
+    last_error = None
+
+    for attempt in range(1, max_attempts + 1):
+        try:
+            result = submit_callable(*args, **kwargs)
+            logger.info(
+                "agent_submit_success",
+                extra={
+                    "cause_code": f"{cause_code}:ok",
+                    "attempt": attempt,
+                    "max_attempts": max_attempts,
+                },
+            )
+            return result
+        except Exception as exc:
+            last_error = exc
+            logger.warning(
+                "agent_submit_failure",
+                extra={
+                    "cause_code": f"{cause_code}:fail",
+                    "attempt": attempt,
+                    "max_attempts": max_attempts,
+                    "error_type": type(exc).__name__,
+                    "error": str(exc),
+                },
+                exc_info=True,
+            )
+            if attempt < max_attempts:
+                time.sleep(0.1 + random.random() * 0.25)
+
+    logger.error(
+        "agent_submit_exhausted",
+        extra={
+            "cause_code": f"{cause_code}:exhausted",
+            "max_attempts": max_attempts,
+            "error_type": type(last_error).__name__,
+            "error": str(last_error),
+        },
+        exc_info=True,
+    )
+    raise AgentSubmitError(f"{cause_code}:fail", last_error)
+
