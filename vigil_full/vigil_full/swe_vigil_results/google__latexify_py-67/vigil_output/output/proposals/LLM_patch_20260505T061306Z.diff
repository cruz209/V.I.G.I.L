diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,52 @@
+import json
+import logging
+import random
+import time
+
+
+logger = logging.getLogger(__name__)
+
+
+def log_structured_error(cause_code, exc, **context):
+    """Emit a machine-readable error event for agent failure triage."""
+    payload = {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "error_type": type(exc).__name__,
+        "message": str(exc),
+        "context": context,
+    }
+    logger.error(json.dumps(payload, sort_keys=True))
+
+
+def call_with_observability(action, *args, cause_code="agent.submit", retries=1, jitter_seconds=0.25, **kwargs):
+    """Run an agent action with structured logging and one jittered retry.
+
+    This hardens submit-like paths observed in logs as `agent.submit:fail` while
+    preserving successful behavior.  Failures are logged with stable cause codes
+    so future RBT diagnosis can distinguish transient tool failures from logic
+    errors.
+    """
+    attempts = retries + 1
+    for attempt in range(1, attempts + 1):
+        try:
+            result = action(*args, **kwargs)
+            logger.info(
+                json.dumps(
+                    {
+                        "event": "agent.action.ok",
+                        "cause_code": cause_code,
+                        "attempt": attempt,
+                    },
+                    sort_keys=True,
+                )
+            )
+            return result
+        except Exception as exc:
+            log_structured_error(cause_code, exc, attempt=attempt, max_attempts=attempts)
+            if attempt >= attempts:
+                raise
+            time.sleep(random.uniform(0, jitter_seconds))
+
+
