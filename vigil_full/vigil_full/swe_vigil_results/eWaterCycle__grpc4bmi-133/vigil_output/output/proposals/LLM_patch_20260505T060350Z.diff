--- a/agent.py
+++ b/agent.py
@@ -0,0 +1,103 @@
+"""Agent reliability helpers.
+
+This module includes a small observability wrapper for submit paths.  It is
+intentionally dependency-free so it can be imported from existing agent code
+without changing runtime requirements.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import random
+import time
+from typing import Any, Callable, Mapping, MutableMapping, Optional, TypeVar
+
+
+T = TypeVar("T")
+
+
+def _structured_agent_log(
+    logger: logging.Logger,
+    level: int,
+    event: str,
+    *,
+    cause_code: str,
+    attempt: int,
+    max_attempts: int,
+    error: Optional[BaseException] = None,
+    extra: Optional[Mapping[str, Any]] = None,
+) -> None:
+    """Emit machine-readable submit telemetry with stable cause codes."""
+
+    payload: MutableMapping[str, Any] = {
+        "event": event,
+        "cause_code": cause_code,
+        "attempt": attempt,
+        "max_attempts": max_attempts,
+    }
+    if error is not None:
+        payload["error_type"] = type(error).__name__
+        payload["error"] = str(error)
+    if extra:
+        payload.update(dict(extra))
+
+    logger.log(level, "agent_submit_event %s", json.dumps(payload, sort_keys=True))
+
+
+def submit_with_observability(
+    submit_call: Callable[[], T],
+    *,
+    logger: Optional[logging.Logger] = None,
+    cause_code: str = "agent.submit",
+    max_attempts: int = 2,
+    base_jitter_seconds: float = 0.25,
+    context: Optional[Mapping[str, Any]] = None,
+) -> T:
+    """Run an agent submit action with structured logging and one retry.
+
+    Recent RBT diagnosis identified ``agent.submit:fail`` as the top thorn.
+    This wrapper preserves successful behavior while making failures visible and
+    retrying transient errors once with jitter.
+
+    Args:
+        submit_call: Zero-argument callable that performs the submit.
+        logger: Optional logger; defaults to this module's logger.
+        cause_code: Stable cause code emitted in logs.
+        max_attempts: Total attempts, including the initial attempt. Defaults to
+            2 so failures are retried once.
+        base_jitter_seconds: Upper bound for random sleep before retries.
+        context: Optional structured metadata, such as task id or backend name.
+
+    Returns:
+        The value returned by ``submit_call``.
+
+    Raises:
+        ValueError: If ``max_attempts`` is less than 1.
+        Exception: Re-raises the final submit exception after logging it.
+    """
+
+    if max_attempts < 1:
+        raise ValueError("max_attempts must be >= 1")
+
+    log = logger or logging.getLogger(__name__)
+    last_error: Optional[BaseException] = None
+
+    for attempt in range(1, max_attempts + 1):
+        try:
+            result = submit_call()
+            _structured_agent_log(
+                log,
+                logging.INFO,
+                "submit_ok",
+                cause_code=f"{cause_code}:ok",
+                attempt=attempt,
+                max_attempts=max_attempts,
+                extra=context,
+            )
+            return result
+        except Exception as exc:  # pragma: no cover - behavior validated by caller integration tests
+            last_error = exc
+            is_final_attempt = attempt >= max_attempts
+            _structured_agent_log(
+                log,
+                logging.ERROR if is_final_attempt else logging.WARNING,
+                "submit_fail",
+                cause_code=f"{cause_code}:fail",
+                attempt=attempt,
+                max_attempts=max_attempts,
+                error=exc,
+                extra=context,
+            )
+            if is_final_attempt:
+                raise
+            time.sleep(random.uniform(0.0, base_jitter_seconds))
+
+    # Defensive fallback for type-checkers; loop either returns or raises.
+    assert last_error is not None
+    raise last_error
