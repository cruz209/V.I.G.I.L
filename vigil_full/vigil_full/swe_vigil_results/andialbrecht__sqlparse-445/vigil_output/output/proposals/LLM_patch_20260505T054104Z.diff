--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,63 @@
+import json
+import logging
+import random
+import time
+
+
+logger = logging.getLogger(__name__)
+
+
+def _log_structured_error(cause_code, exc, **context):
+    """Emit machine-readable error details for failed agent operations.
+
+    The RBT diagnosis identified agent.submit failures as the main thorn.  Keep
+    the log payload compact and stable so downstream monitors can group events
+    by ``cause_code`` while still preserving enough context for debugging.
+    """
+    payload = {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "error_type": type(exc).__name__,
+        "error": str(exc),
+        "context": context,
+    }
+    logger.error(json.dumps(payload, sort_keys=True))
+
+
+def submit_with_observability(submit_callable, *args, max_retries=1, jitter_seconds=0.25, **kwargs):
+    """Run an agent.submit-like callable with structured logging and one retry.
+
+    Args:
+        submit_callable: Callable that performs the submit operation.
+        *args: Positional arguments forwarded to ``submit_callable``.
+        max_retries: Number of retries after the initial attempt. Defaults to 1
+            per the reliability guidance from recent RBT reflection.
+        jitter_seconds: Upper bound for retry sleep jitter.
+        **kwargs: Keyword arguments forwarded to ``submit_callable``.
+
+    Returns:
+        Whatever ``submit_callable`` returns.
+
+    Raises:
+        The final exception if all attempts fail.
+    """
+    attempts = max_retries + 1
+    for attempt in range(1, attempts + 1):
+        try:
+            result = submit_callable(*args, **kwargs)
+            logger.info(
+                json.dumps(
+                    {
+                        "event": "agent.submit",
+                        "status": "ok",
+                        "attempt": attempt,
+                    },
+                    sort_keys=True,
+                )
+            )
+            return result
+        except Exception as exc:
+            _log_structured_error(
+                "agent.submit.fail",
+                exc,
+                attempt=attempt,
+                max_attempts=attempts,
+            )
+            if attempt >= attempts:
+                raise
+            time.sleep(random.uniform(0, jitter_seconds))
+
