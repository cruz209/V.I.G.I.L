diff --git a/agent.py b/agent.py
index 0000000..1111111 100644
--- a/agent.py
+++ b/agent.py
@@ -1,0 +1,90 @@
+import json
+import logging
+import random
+import time
+from typing import Any, Callable, Dict, Optional, TypeVar
+
+
+_T = TypeVar("_T")
+
+
+AGENT_LOGGER = logging.getLogger("robin_b.agent")
+
+
+def log_structured_error(
+    *,
+    cause_code: str,
+    error: BaseException,
+    context: Optional[Dict[str, Any]] = None,
+) -> None:
+    """Emit machine-readable error details for thorn diagnosis.
+
+    Recent logs showed an ``agent.submit`` failure without enough structured
+    evidence to identify the exact failing path. Keeping this helper in the
+    agent module makes failures searchable by ``cause_code`` while preserving
+    the existing exception flow for callers.
+    """
+
+    payload = {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "error_type": type(error).__name__,
+        "error_message": str(error),
+        "context": context or {},
+    }
+    AGENT_LOGGER.error(json.dumps(payload, sort_keys=True))
+
+
+def call_with_single_retry(
+    operation: Callable[..., _T],
+    *args: Any,
+    cause_code: str = "agent.operation:fail",
+    jitter_seconds: float = 0.25,
+    context: Optional[Dict[str, Any]] = None,
+    **kwargs: Any,
+) -> _T:
+    """Run an operation and retry once with jitter on failure.
+
+    Use this around submit-like operations to convert transient failures into a
+    single retry while logging both the original failure and the retry failure
+    with structured cause codes.
+    """
+
+    try:
+        return operation(*args, **kwargs)
+    except Exception as first_error:
+        log_structured_error(
+            cause_code=cause_code,
+            error=first_error,
+            context={**(context or {}), "attempt": 1, "will_retry": True},
+        )
+        if jitter_seconds > 0:
+            time.sleep(random.uniform(0, jitter_seconds))
+
+    try:
+        return operation(*args, **kwargs)
+    except Exception as retry_error:
+        log_structured_error(
+            cause_code=cause_code,
+            error=retry_error,
+            context={**(context or {}), "attempt": 2, "will_retry": False},
+        )
+        raise
+
+
+def submit_with_observability(
+    submit_callable: Callable[..., _T],
+    *args: Any,
+    context: Optional[Dict[str, Any]] = None,
+    **kwargs: Any,
+) -> _T:
+    """Submit through a standardized retry/logging wrapper.
+
+    This utility directly addresses the observed ``agent.submit:fail`` thorn by
+    giving submit paths a consistent cause code and one automatic retry.
+    """
+
+    return call_with_single_retry(
+        submit_callable,
+        *args,
+        cause_code="agent.submit:fail",
+        context=context,
+        **kwargs,
+    )
