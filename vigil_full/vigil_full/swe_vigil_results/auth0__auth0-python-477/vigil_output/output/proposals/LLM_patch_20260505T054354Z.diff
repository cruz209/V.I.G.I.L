--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,92 @@
+import functools
+import json
+import logging
+import random
+import time
+
+
+AGENT_LOG = logging.getLogger(__name__)
+
+
+def _structured_agent_error(cause_code, exc, **context):
+    """Emit a machine-readable error record for agent failure paths.
+
+    Recent reflection identified `agent.submit:fail` as the top thorn.  This
+    helper keeps the existing behaviour intact while making failures observable
+    enough to diagnose and correlate in logs.
+    """
+    event = {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "error_type": type(exc).__name__,
+        "error": str(exc),
+    }
+    event.update({k: v for k, v in context.items() if v is not None})
+    AGENT_LOG.error(json.dumps(event, sort_keys=True), exc_info=True)
+
+
+def retry_once_with_jitter(cause_code, *, min_delay=0.05, max_delay=0.25):
+    """Retry a failing agent operation once and log structured failures.
+
+    Use this decorator on submit/tool-call boundaries. It preserves successful
+    paths, retries transient errors once, and surfaces a structured cause code
+    if the retry also fails.
+    """
+    def decorate(fn):
+        @functools.wraps(fn)
+        def wrapper(*args, **kwargs):
+            try:
+                return fn(*args, **kwargs)
+            except Exception as first_error:
+                _structured_agent_error(
+                    cause_code,
+                    first_error,
+                    phase="initial_attempt",
+                    operation=getattr(fn, "__name__", "unknown"),
+                )
+                time.sleep(random.uniform(min_delay, max_delay))
+                try:
+                    return fn(*args, **kwargs)
+                except Exception as retry_error:
+                    _structured_agent_error(
+                        cause_code,
+                        retry_error,
+                        phase="retry_attempt",
+                        operation=getattr(fn, "__name__", "unknown"),
+                    )
+                    raise
+
+        return wrapper
+
+    return decorate
+
+
+def submit_with_observability(submit_callable, *args, **kwargs):
+    """Call an agent submit function with a one-shot retry and telemetry.
+
+    This utility is intentionally generic so existing submit implementations can
+    opt in without changing their public API:
+
+        result = submit_with_observability(agent.submit, payload)
+
+    """
+    wrapped_submit = retry_once_with_jitter("agent.submit:fail")(submit_callable)
+    return wrapped_submit(*args, **kwargs)
+
