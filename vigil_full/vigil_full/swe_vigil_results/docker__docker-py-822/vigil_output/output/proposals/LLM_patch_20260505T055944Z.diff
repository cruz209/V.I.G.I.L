diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,40 @@
+import json
+import logging
+import random
+import time
+
+logger = logging.getLogger(__name__)
+
+
+def log_structured_error(cause_code, exc, **context):
+    """Emit machine-readable failure details for thorn diagnosis."""
+    payload = {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "error_type": type(exc).__name__,
+        "error": str(exc),
+        "context": context,
+    }
+    logger.error(json.dumps(payload, sort_keys=True))
+
+
+def call_with_single_retry(operation, *, cause_code, retry_delay_range=(0.05, 0.25), **context):
+    """Run an operation, retrying once with jitter while logging structured failures.
+
+    This preserves successful paths while making intermittent submit failures observable
+    and recoverable.
+    """
+    try:
+        return operation()
+    except Exception as exc:
+        log_structured_error(cause_code, exc, attempt=1, **context)
+        time.sleep(random.uniform(*retry_delay_range))
+        try:
+            return operation()
+        except Exception as retry_exc:
+            log_structured_error(cause_code, retry_exc, attempt=2, **context)
+            raise
+
 