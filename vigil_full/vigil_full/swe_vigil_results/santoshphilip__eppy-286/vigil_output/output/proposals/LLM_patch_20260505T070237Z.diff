--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,68 @@
+import json
+import logging
+import random
+import time
+
+
+logger = logging.getLogger(__name__)
+
+
+def log_structured_error(cause_code, exc, **context):
+    """Emit a machine-readable error event for agent failure paths.
+
+    The RBT diagnosis identified ``agent.submit:fail`` as the top thorn. This
+    helper standardizes error logging so submit failures include a stable cause
+    code and enough context for later reflection/diagnosis.
+    """
+    event = {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "error_type": type(exc).__name__,
+        "error": str(exc),
+        "context": context,
+    }
+    logger.error(json.dumps(event, sort_keys=True), exc_info=True)
+
+
+def retry_once_with_jitter(operation, *, cause_code="agent.submit:fail", max_jitter_seconds=0.25, **context):
+    """Run ``operation`` and retry once after a short jittered delay on failure.
+
+    This preserves successful paths while hardening transient submit failures.
+    If both attempts fail, a structured error is logged and the original
+    exception is re-raised so callers still receive a clear failure signal.
+    """
+    try:
+        return operation()
+    except Exception as first_exc:
+        log_structured_error(cause_code, first_exc, attempt=1, **context)
+        time.sleep(random.uniform(0, max_jitter_seconds))
+        try:
+            return operation()
+        except Exception as second_exc:
+            log_structured_error(cause_code, second_exc, attempt=2, **context)
+            raise
+
+
+def submit_with_observability(submit_callable, *args, **kwargs):
+    """Submit through a callable with structured errors and one retry.
+
+    Use this wrapper around agent.submit call sites:
+
+        submit_with_observability(agent.submit, payload)
+
+    It intentionally avoids changing success semantics; it only adds logging and
+    one jittered retry when the submit path raises.
+    """
+    def _operation():
+        return submit_callable(*args, **kwargs)
+
+    return retry_once_with_jitter(
+        _operation,
+        cause_code="agent.submit:fail",
+        callable_name=getattr(submit_callable, "__name__", repr(submit_callable)),
+    )
+
