diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -0,0 +1,79 @@
+"""Agent reliability utilities.
+
+This module-level helper is intentionally dependency-light so submit paths can
+surface structured error events and retry once without changing caller behavior.
+"""
+
+from __future__ import annotations
+
+import logging
+import random
+import time
+from typing import Any, Callable, TypeVar
+
+
+LOGGER = logging.getLogger(__name__)
+T = TypeVar("T")
+
+
+def submit_with_observability(
+    submit_fn: Callable[..., T],
+    *args: Any,
+    cause_code: str = "agent.submit",
+    retries: int = 1,
+    jitter_seconds: float = 0.25,
+    **kwargs: Any,
+) -> T:
+    """Run a submit callable with structured logging and one retry by default.
+
+    Recent RBT diagnosis identified ``agent.submit:fail`` as the top thorn.
+    Wrapping submit calls with this helper preserves the successful path while
+    adding observability for failures and an automatic retry with small jitter.
+
+    Args:
+        submit_fn: Callable that performs the actual submit operation.
+        *args: Positional arguments forwarded to ``submit_fn``.
+        cause_code: Stable cause code used in structured logs.
+        retries: Number of retries after the initial attempt.
+        jitter_seconds: Maximum random delay before each retry.
+        **kwargs: Keyword arguments forwarded to ``submit_fn``.
+
+    Returns:
+        The result returned by ``submit_fn``.
+
+    Raises:
+        The last exception raised by ``submit_fn`` after retries are exhausted.
+    """
+
+    if not callable(submit_fn):
+        raise TypeError("submit_fn must be callable")
+    if retries < 0:
+        raise ValueError("retries must be non-negative")
+    if jitter_seconds < 0:
+        raise ValueError("jitter_seconds must be non-negative")
+
+    attempts = retries + 1
+    last_error: BaseException | None = None
+    for attempt in range(1, attempts + 1):
+        try:
+            result = submit_fn(*args, **kwargs)
+            LOGGER.info(
+                "agent_submit_ok",
+                extra={
+                    "cause_code": f"{cause_code}:ok",
+                    "attempt": attempt,
+                    "max_attempts": attempts,
+                },
+            )
+            return result
+        except Exception as exc:  # pragma: no cover - preserves original failure
+            last_error = exc
+            LOGGER.warning(
+                "agent_submit_fail",
+                extra={
+                    "cause_code": f"{cause_code}:fail",
+                    "attempt": attempt,
+                    "max_attempts": attempts,
+                    "error_type": type(exc).__name__,
+                    "retrying": attempt < attempts,
+                },
+                exc_info=True,
+            )
+            if attempt < attempts and jitter_seconds:
+                time.sleep(random.uniform(0, jitter_seconds))
+    assert last_error is not None
+    raise last_error
