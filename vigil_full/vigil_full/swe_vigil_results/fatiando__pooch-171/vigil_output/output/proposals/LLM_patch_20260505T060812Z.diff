diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,101 @@
+import json as _rb_json
+import logging as _rb_logging
+import random as _rb_random
+import time as _rb_time
+from functools import wraps as _rb_wraps
+
+
+_RB_LOG = _rb_logging.getLogger(__name__)
+
+
+def _rb_structured_error(event, *, cause, error, **fields):
+    """Emit a structured error record for agent failure paths.
+
+    The recent RBT diagnosis identified ``agent.submit`` failures as the
+    highest-impact thorn.  Keep this helper intentionally dependency-free so it
+    can be used from any submit/tool wrapper without changing runtime setup.
+    """
+    record = {
+        "event": event,
+        "cause": cause,
+        "error_type": type(error).__name__,
+        "error": str(error),
+    }
+    record.update(fields)
+    try:
+        payload = _rb_json.dumps(record, sort_keys=True, default=str)
+    except Exception:  # pragma: no cover - defensive logging path
+        payload = repr(record)
+    _RB_LOG.error("agent_failure %s", payload)
+    return record
+
+
+def _rb_retry_once_with_jitter(func=None, *, cause="agent.submit", base_delay=0.25, jitter=0.15):
+    """Retry a callable once and log structured cause-coded failures.
+
+    Use as ``@_rb_retry_once_with_jitter(cause=\"agent.submit\")`` around
+    submit-like operations, or call it with a function directly.  The first
+    failure is surfaced to logs with ``will_retry=True``; the second failure is
+    logged with ``will_retry=False`` and re-raised to preserve existing error
+    semantics for callers.
+    """
+
+    def decorator(inner):
+        @_rb_wraps(inner)
+        def wrapper(*args, **kwargs):
+            try:
+                return inner(*args, **kwargs)
+            except Exception as exc:
+                _rb_structured_error(
+                    "call_failed",
+                    cause=cause,
+                    error=exc,
+                    attempt=1,
+                    will_retry=True,
+                )
+                delay = max(0.0, base_delay + _rb_random.uniform(0.0, jitter))
+                if delay:
+                    _rb_time.sleep(delay)
+                try:
+                    return inner(*args, **kwargs)
+                except Exception as retry_exc:
+                    _rb_structured_error(
+                        "call_failed",
+                        cause=cause,
+                        error=retry_exc,
+                        attempt=2,
+                        will_retry=False,
+                    )
+                    raise
+
+        return wrapper
+
+    if func is not None:
+        return decorator(func)
+    return decorator
+
+
+def _rb_validate_submit_payload(payload):
+    """Validate submit payloads before dispatching to reduce opaque failures."""
+    if payload is None:
+        raise ValueError("agent.submit payload must not be None")
+    if isinstance(payload, dict) and not payload:
+        raise ValueError("agent.submit payload must not be an empty object")
+    return payload
+
