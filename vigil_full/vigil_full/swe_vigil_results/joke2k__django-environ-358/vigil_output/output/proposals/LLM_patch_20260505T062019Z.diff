diff --git a/agent.py b/agent.py
index 0000000..1111111 100644
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,78 @@
+import json
+import logging
+import random
+import time
+
+LOGGER = logging.getLogger(__name__)
+
+
+def _log_structured_event(event, *, cause, status, **fields):
+    """Emit structured agent telemetry without changing caller behavior.
+
+    The RBT review found an agent.submit failure.  This helper gives failing
+    paths stable cause codes while keeping logs parseable by existing JSONL
+    ingestion.
+    """
+    payload = {
+        "event": event,
+        "cause": cause,
+        "status": status,
+        **fields,
+    }
+    try:
+        LOGGER.info("agent_event %s", json.dumps(payload, sort_keys=True, default=str))
+    except Exception:
+        LOGGER.info("agent_event %r", payload)
+
+
+def submit_with_observability(submit_callable, *args, retries=1, base_delay=0.2, **kwargs):
+    """Run an agent.submit callable with one jittered retry and structured logs.
+
+    Use this wrapper at submit boundaries, for example:
+
+        result = submit_with_observability(agent.submit, payload)
+
+    It preserves successful submit behavior, surfaces failures with the
+    ``agent.submit`` cause code, and retries transient failures once by default.
+    """
+    attempts = max(1, int(retries) + 1)
+    last_error = None
+
+    for attempt in range(1, attempts + 1):
+        try:
+            result = submit_callable(*args, **kwargs)
+            _log_structured_event(
+                "agent.submit",
+                cause="agent.submit",
+                status="ok",
+                attempt=attempt,
+            )
+            return result
+        except Exception as exc:
+            last_error = exc
+            _log_structured_event(
+                "agent.submit",
+                cause="agent.submit",
+                status="fail",
+                attempt=attempt,
+                error_type=type(exc).__name__,
+                error=str(exc),
+            )
+            if attempt >= attempts:
+                break
+
+            delay = max(0.0, float(base_delay)) * (1 + random.random())
+            _log_structured_event(
+                "agent.submit.retry",
+                cause="agent.submit",
+                status="scheduled",
+                attempt=attempt + 1,
+                delay_seconds=round(delay, 3),
+            )
+            time.sleep(delay)
+
+    raise last_error
+
