diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,80 @@
+import json
+import logging
+import random
+import time
+
+
+logger = logging.getLogger(__name__)
+
+
+class AgentSubmitError(RuntimeError):
+    """Raised when an agent submit action fails after retry."""
+
+
+def _structured_log(level, event, **fields):
+    """Emit structured logs for agent events without disrupting callers."""
+    payload = {"event": event, **fields}
+    try:
+        message = json.dumps(payload, sort_keys=True, default=str)
+    except TypeError:
+        message = repr(payload)
+    logger.log(level, message)
+
+
+def _retry_once_with_jitter(operation, *, cause_code, action, jitter_range=(0.05, 0.25)):
+    """Run an operation, retrying once with jitter and structured errors.
+
+    This centralizes the RBT hardening for the observed `agent.submit:fail`
+    thorn: callers get one automatic retry, while logs retain a stable
+    cause_code that downstream diagnostics can aggregate.
+    """
+    try:
+        return operation()
+    except Exception as first_error:
+        delay = random.uniform(*jitter_range)
+        _structured_log(
+            logging.WARNING,
+            "agent.operation.retry",
+            action=action,
+            cause_code=cause_code,
+            attempt=1,
+            retry_delay_seconds=round(delay, 3),
+            error_type=type(first_error).__name__,
+            error=str(first_error),
+        )
+        time.sleep(delay)
+
+        try:
+            return operation()
+        except Exception as retry_error:
+            _structured_log(
+                logging.ERROR,
+                "agent.operation.failed",
+                action=action,
+                cause_code=cause_code,
+                attempts=2,
+                error_type=type(retry_error).__name__,
+                error=str(retry_error),
+                first_error_type=type(first_error).__name__,
+                first_error=str(first_error),
+            )
+            raise AgentSubmitError(
+                f"{action} failed after retry; cause_code={cause_code}"
+            ) from retry_error
+
+
+def submit_with_observability(submit_callable, *args, **kwargs):
+    """Submit through a callable with retry and structured diagnostics.
+
+    Existing submit call sites can be migrated from:
+        submit(payload)
+    to:
+        submit_with_observability(submit, payload)
+    preserving successful behavior while making `agent.submit:fail` actionable.
+    """
+    return _retry_once_with_jitter(
+        lambda: submit_callable(*args, **kwargs),
+        cause_code="agent.submit:fail",
+        action="agent.submit",
+    )
+
