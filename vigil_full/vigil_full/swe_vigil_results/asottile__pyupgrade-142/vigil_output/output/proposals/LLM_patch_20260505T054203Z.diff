diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,74 @@
+import functools
+import json
+import logging
+import random
+import time
+
+
+_LOGGER = logging.getLogger(__name__)
+
+
+def _structured_error(cause_code, exc, **details):
+    """Return a stable, machine-readable error payload for agent failures."""
+    payload = {
+        "cause_code": cause_code,
+        "error_type": type(exc).__name__,
+        "error": str(exc),
+    }
+    if details:
+        payload["details"] = details
+    return payload
+
+
+def log_structured_error(cause_code, exc, **details):
+    """Log failing paths with consistent cause codes for post-run diagnosis."""
+    payload = _structured_error(cause_code, exc, **details)
+    _LOGGER.error("agent_error %s", json.dumps(payload, sort_keys=True))
+    return payload
+
+
+def retry_once_with_jitter(cause_code, *, min_delay=0.05, max_delay=0.25):
+    """Retry a failing operation once and log both failed attempts.
+
+    The recent RBT diagnosis identified ``agent.submit:fail`` as the top thorn.
+    This decorator keeps successful behavior unchanged while adding observability
+    and a single low-cost retry for transient submit/tool failures.
+    """
+    if min_delay < 0 or max_delay < min_delay:
+        raise ValueError("retry jitter bounds must satisfy 0 <= min_delay <= max_delay")
+
+    def decorate(func):
+        @functools.wraps(func)
+        def wrapped(*args, **kwargs):
+            try:
+                return func(*args, **kwargs)
+            except Exception as exc:
+                log_structured_error(cause_code, exc, attempt=1, retrying=True)
+                time.sleep(random.uniform(min_delay, max_delay))
+                try:
+                    return func(*args, **kwargs)
+                except Exception as retry_exc:
+                    log_structured_error(cause_code, retry_exc, attempt=2, retrying=False)
+                    raise
+
+        return wrapped
+
+    return decorate
+
+
+def validate_submit_payload(payload):
+    """Validate submit payload shape before invoking the submit path."""
+    if payload is None:
+        raise ValueError("submit payload must not be None")
+    if isinstance(payload, dict) and payload.get("error"):
+        raise ValueError("submit payload must not contain a pre-existing error marker")
+    return payload
+
+
+def submit_with_observability(submit_func, payload, *args, **kwargs):
+    """Submit through a validated, observable, one-retry wrapper."""
+    validate_submit_payload(payload)
+    guarded_submit = retry_once_with_jitter("agent.submit:fail")(submit_func)
+    return guarded_submit(payload, *args, **kwargs)
+
