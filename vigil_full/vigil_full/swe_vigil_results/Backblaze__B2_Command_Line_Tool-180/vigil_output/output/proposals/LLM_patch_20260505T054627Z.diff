diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -0,0 +1,76 @@
+"""Agent observability and retry helpers.
+
+These helpers harden submit-like operations by emitting structured error records
+with stable cause codes and retrying transient failures once with small jitter.
+They are intentionally dependency-free so they can be imported by existing agent
+entry points without changing normal successful behavior.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import random
+import time
+from typing import Any, Callable, Dict, Optional, TypeVar
+
+
+_T = TypeVar("_T")
+_LOGGER = logging.getLogger("agent.observability")
+
+
+def log_structured_error(
+    cause: str,
+    exc: BaseException,
+    *,
+    attempt: int,
+    max_attempts: int,
+    extra: Optional[Dict[str, Any]] = None,
+) -> None:
+    """Log a machine-readable error record for failing agent paths.
+
+    Args:
+        cause: Stable cause code, for example ``agent.submit:fail``.
+        exc: The exception that triggered the failure path.
+        attempt: 1-based attempt number.
+        max_attempts: Total attempts that will be made.
+        extra: Optional contextual fields safe to write to logs.
+    """
+    record: Dict[str, Any] = {
+        "event": "agent.error",
+        "cause": cause,
+        "attempt": attempt,
+        "max_attempts": max_attempts,
+        "exception_type": type(exc).__name__,
+        "exception_message": str(exc),
+    }
+    if extra:
+        record["extra"] = extra
+    _LOGGER.error(json.dumps(record, sort_keys=True))
+
+
+def call_with_observability_retry(
+    operation: Callable[..., _T],
+    *args: Any,
+    cause: str = "agent.submit:fail",
+    retries: int = 1,
+    jitter_seconds: float = 0.25,
+    extra: Optional[Dict[str, Any]] = None,
+    **kwargs: Any,
+) -> _T:
+    """Run an operation, logging structured failures and retrying once by default.
+
+    Successful calls are returned unchanged. On failure, a structured error is
+    logged with the provided cause code. If retries remain, the helper waits for
+    a bounded random jitter before trying again. After all attempts fail, the
+    original exception from the final attempt is re-raised to preserve existing
+    error semantics for callers.
+    """
+    max_attempts = retries + 1
+    for attempt in range(1, max_attempts + 1):
+        try:
+            return operation(*args, **kwargs)
+        except Exception as exc:
+            log_structured_error(
+                cause,
+                exc,
+                attempt=attempt,
+                max_attempts=max_attempts,
+                extra=extra,
+            )
+            if attempt >= max_attempts:
+                raise
+            time.sleep(random.uniform(0.0, max(0.0, jitter_seconds)))
+
+    raise RuntimeError("unreachable retry state")
