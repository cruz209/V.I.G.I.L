--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,52 @@
+import json
+import logging
+import random
+import time
+
+logger = logging.getLogger(__name__)
+
+
+def _log_structured_error(cause_code, exc, **context):
+    """Emit machine-readable error details for failing agent paths."""
+    logger.error(
+        "agent_error",
+        extra={
+            "cause_code": cause_code,
+            "error_type": type(exc).__name__,
+            "error_message": str(exc),
+            "context_json": json.dumps(context, sort_keys=True, default=str),
+        },
+    )
+
+
+def submit_with_observability(submit_fn, *args, retries=1, jitter_seconds=0.25, **kwargs):
+    """Run agent.submit with structured logging and a single jittered retry.
+
+    Recent reflection identified `agent.submit:fail` as the top thorn.  This
+    wrapper preserves the existing submit behavior on success while surfacing a
+    stable cause code and retrying once for transient failures.
+    """
+    attempts = retries + 1
+    last_exc = None
+    for attempt in range(1, attempts + 1):
+        try:
+            result = submit_fn(*args, **kwargs)
+            logger.info(
+                "agent_submit_ok",
+                extra={"cause_code": "agent.submit:ok", "attempt": attempt},
+            )
+            return result
+        except Exception as exc:
+            last_exc = exc
+            _log_structured_error(
+                "agent.submit:fail",
+                exc,
+                attempt=attempt,
+                max_attempts=attempts,
+            )
+            if attempt >= attempts:
+                break
+            time.sleep(random.uniform(0, jitter_seconds))
+    raise last_exc
+
