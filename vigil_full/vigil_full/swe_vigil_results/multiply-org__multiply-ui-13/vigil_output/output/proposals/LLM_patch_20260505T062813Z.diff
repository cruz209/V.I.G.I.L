diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,61 @@
+import json
+import logging
+import random
+import time
+
+LOGGER = logging.getLogger(__name__)
+
+
+def _log_structured_agent_event(level, event, *, cause_code, attempt=None, error=None, **fields):
+    """Emit machine-readable agent events for thorn diagnosis and retry auditing."""
+    payload = {
+        "event": event,
+        "cause_code": cause_code,
+    }
+    if attempt is not None:
+        payload["attempt"] = attempt
+    if error is not None:
+        payload["error_type"] = type(error).__name__
+        payload["error"] = str(error)
+    payload.update(fields)
+    LOGGER.log(level, json.dumps(payload, sort_keys=True))
+
+
+def submit_with_observability(submit_fn, *args, cause_code="agent.submit", retries=1, jitter_seconds=0.25, **kwargs):
+    """Call an agent submit function with structured errors and one jittered retry.
+
+    Recent RBT diagnostics identified `agent.submit:fail` as the active thorn. This
+    wrapper preserves existing submit behavior on success while adding structured
+    observability and a bounded retry path for transient failures.
+    """
+    max_attempts = max(1, retries + 1)
+    for attempt in range(1, max_attempts + 1):
+        try:
+            result = submit_fn(*args, **kwargs)
+        except Exception as exc:
+            _log_structured_agent_event(
+                logging.ERROR,
+                "agent_submit_failed",
+                cause_code=f"{cause_code}:fail",
+                attempt=attempt,
+                error=exc,
+            )
+            if attempt >= max_attempts:
+                raise
+            sleep_for = random.uniform(0, max(0.0, jitter_seconds))
+            _log_structured_agent_event(
+                logging.INFO,
+                "agent_submit_retrying",
+                cause_code=f"{cause_code}:retry",
+                attempt=attempt + 1,
+                jitter_seconds=round(sleep_for, 4),
+            )
+            time.sleep(sleep_for)
+            continue
+
+        _log_structured_agent_event(
+            logging.INFO,
+            "agent_submit_succeeded",
+            cause_code=f"{cause_code}:ok",
+            attempt=attempt,
+        )
+        return result
+
