index 2b1c3d4..8e9f0a1 100644
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,64 @@
+import json
+import logging
+import random
+import time
+
+logger = logging.getLogger(__name__)
+
+
+def _log_structured_event(level, event, **fields):
+    """Emit structured JSON logs for agent reliability diagnostics.
+
+    These logs make submit failures actionable by preserving the failing
+    cause code, attempt number, and exception class in a machine-readable
+    format for the RBT/EmoBank feedback loop.
+    """
+    payload = {"event": event, **fields}
+    log = getattr(logger, level, logger.info)
+    log(json.dumps(payload, sort_keys=True, default=str))
+
+
+def submit_with_observability(submit_func, *args, cause="agent.submit", retries=1, jitter_seconds=0.25, **kwargs):
+    """Call an agent submit function with structured logging and one retry.
+
+    Args:
+        submit_func: Callable that performs the submit operation.
+        *args: Positional arguments forwarded to ``submit_func``.
+        cause: Stable cause code used by diagnostics.
+        retries: Number of retries after the initial attempt.
+        jitter_seconds: Maximum random backoff between attempts.
+        **kwargs: Keyword arguments forwarded to ``submit_func``.
+
+    Returns:
+        The value returned by ``submit_func``.
+
+    Raises:
+        The final exception from ``submit_func`` after all retries are exhausted.
+    """
+    max_attempts = max(1, int(retries) + 1)
+    for attempt in range(1, max_attempts + 1):
+        try:
+            result = submit_func(*args, **kwargs)
+            _log_structured_event(
+                "info",
+                "agent.submit.ok",
+                cause=f"{cause}:ok",
+                attempt=attempt,
+                max_attempts=max_attempts,
+            )
+            return result
+        except Exception as exc:
+            _log_structured_event(
+                "error",
+                "agent.submit.fail",
+                cause=f"{cause}:fail",
+                attempt=attempt,
+                max_attempts=max_attempts,
+                error_type=type(exc).__name__,
+                error=str(exc),
+            )
+            if attempt >= max_attempts:
+                raise
+            if jitter_seconds > 0:
+                time.sleep(random.uniform(0, jitter_seconds))
+
