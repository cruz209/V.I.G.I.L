diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,44 @@
+import json
+import logging
+import time
+
+
+_SUBMIT_LOGGER = logging.getLogger("agent.submit")
+
+
+def log_submit_error(exc, *, cause_code="agent.submit:fail", **context):
+    """Emit a structured error record for failed submit paths.
+
+    Recent RBT diagnostics identified `agent.submit:fail` as the top thorn.
+    Keep this helper dependency-free so it is safe to call from exception
+    handlers without introducing additional failure modes.
+    """
+    record = {
+        "event": "agent.submit.error",
+        "cause_code": cause_code,
+        "error_type": type(exc).__name__,
+        "error": str(exc),
+        "ts": time.time(),
+    }
+    record.update({k: v for k, v in context.items() if v is not None})
+    _SUBMIT_LOGGER.error(json.dumps(record, sort_keys=True))
+
+
+def validate_submit_payload(payload):
+    """Validate submit payloads before calling the external submit path."""
+    if payload is None:
+        raise ValueError("submit payload must not be None")
+    if isinstance(payload, dict) and not payload:
+        raise ValueError("submit payload must not be empty")
+    return payload
+
+
+def safe_submit(submit_func, payload, **context):
+    """Validate, submit, and log structured diagnostics on failure."""
+    try:
+        return submit_func(validate_submit_payload(payload))
+    except Exception as exc:
+        log_submit_error(exc, **context)
+        raise
+
