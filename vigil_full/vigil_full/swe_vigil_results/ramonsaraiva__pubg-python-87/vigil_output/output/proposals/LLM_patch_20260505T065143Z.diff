--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,58 @@
+import json
+import logging
+import random
+import time
+
+
+logger = logging.getLogger(__name__)
+
+
+def _log_structured_error(cause_code, exc, **context):
+    """Emit machine-readable error details for failed agent operations."""
+    logger.error(
+        "agent_error %s",
+        json.dumps(
+            {
+                "cause_code": cause_code,
+                "error_type": type(exc).__name__,
+                "error": str(exc),
+                "context": context,
+            },
+            sort_keys=True,
+        ),
+    )
+
+
+def _with_single_retry(operation, *, cause_code, jitter_seconds=0.25, **context):
+    """Run an operation, retrying once with jitter after a structured failure log."""
+    try:
+        return operation()
+    except Exception as exc:
+        _log_structured_error(cause_code, exc, attempt=1, **context)
+        time.sleep(random.uniform(0, jitter_seconds))
+        try:
+            return operation()
+        except Exception as retry_exc:
+            _log_structured_error(cause_code, retry_exc, attempt=2, **context)
+            raise
+
+
+def submit_with_observability(submit_func, *args, **kwargs):
+    """Submit through the provided callable with retry and structured logging.
+
+    This helper is intentionally small so existing submit behavior can be
+    preserved while adding observability for the observed agent.submit thorn.
+    """
+    def _operation():
+        return submit_func(*args, **kwargs)
+
+    return _with_single_retry(
+        _operation,
+        cause_code="agent.submit:fail",
+        operation="agent.submit",
+        arg_count=len(args),
+        kwarg_names=sorted(kwargs.keys()),
+    )
+
