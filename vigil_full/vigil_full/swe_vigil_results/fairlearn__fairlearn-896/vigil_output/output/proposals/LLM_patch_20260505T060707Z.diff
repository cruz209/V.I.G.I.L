--- a/agent.py
+++ b/agent.py
@@ -0,0 +1,86 @@
+"""Agent observability helpers.
+
+These helpers provide structured logging and one bounded retry for submit-style
+operations. They are intentionally dependency-light so they can be imported by
+the agent without changing runtime requirements.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import random
+import time
+from collections.abc import Callable
+from typing import Any, TypeVar
+
+
+_T = TypeVar("_T")
+_LOGGER = logging.getLogger("robin_b.agent")
+
+
+def log_agent_event(
+    *,
+    cause_code: str,
+    status: str,
+    message: str,
+    **fields: Any,
+) -> None:
+    """Emit a structured agent event with a stable cause code.
+
+    The recent RBT diagnosis identified ``agent.submit:fail`` as the top thorn.
+    Keeping a consistent JSON payload makes failures searchable while preserving
+    successful paths for Rose/Bud monitoring.
+    """
+
+    payload = {
+        "cause_code": cause_code,
+        "status": status,
+        "message": message,
+        **fields,
+    }
+    level = logging.ERROR if status == "fail" else logging.INFO
+    _LOGGER.log(level, json.dumps(payload, sort_keys=True, default=str))
+
+
+def submit_with_observability(
+    submit: Callable[..., _T],
+    *args: Any,
+    cause_code: str = "agent.submit",
+    retry_once: bool = True,
+    jitter_seconds: float = 0.25,
+    **kwargs: Any,
+) -> _T:
+    """Run an agent submit operation with structured logging and one retry.
+
+    Args:
+        submit: Callable that performs the submit operation.
+        *args: Positional arguments forwarded to ``submit``.
+        cause_code: Stable operation identifier used in logs.
+        retry_once: Whether to retry once after the first failure.
+        jitter_seconds: Maximum random sleep before retrying.
+        **kwargs: Keyword arguments forwarded to ``submit``.
+
+    Returns:
+        The return value of ``submit``.
+
+    Raises:
+        The final exception from ``submit`` after logging a structured failure.
+    """
+
+    attempts = 2 if retry_once else 1
+    last_error: BaseException | None = None
+
+    for attempt in range(1, attempts + 1):
+        try:
+            result = submit(*args, **kwargs)
+            log_agent_event(
+                cause_code=f"{cause_code}:ok",
+                status="ok",
+                message="submit completed",
+                attempt=attempt,
+            )
+            return result
+        except Exception as exc:  # pragma: no cover - preserves original error
+            last_error = exc
+            log_agent_event(
+                cause_code=f"{cause_code}:fail",
+                status="fail",
+                message="submit failed",
+                attempt=attempt,
+                error_type=type(exc).__name__,
+                error=str(exc),
+            )
+            if attempt < attempts:
+                time.sleep(random.uniform(0.0, max(0.0, jitter_seconds)))
+
+    raise last_error  # type: ignore[misc]
