--- a/agent.py
+++ b/agent.py
@@ -0,0 +1,93 @@
+import json
+import logging
+import random
+import time
+from typing import Any, Callable, Dict, Optional
+
+
+logger = logging.getLogger(__name__)
+
+
+def _structured_log(
+    level: int,
+    event: str,
+    *,
+    cause_code: str,
+    detail: Optional[str] = None,
+    **fields: Any,
+) -> None:
+    """Emit machine-readable diagnostics for agent failure paths.
+
+    The reflection logs identified ``agent.submit`` as the top thorn.  This
+    helper keeps observability consistent by attaching a stable cause code to
+    every logged failure without changing successful behavior.
+    """
+
+    payload: Dict[str, Any] = {
+        "event": event,
+        "cause_code": cause_code,
+    }
+    if detail:
+        payload["detail"] = detail
+    payload.update(fields)
+    logger.log(level, json.dumps(payload, sort_keys=True, default=str))
+
+
+def submit_with_observability(
+    submit: Callable[..., Any],
+    *args: Any,
+    retries: int = 1,
+    jitter_seconds: float = 0.25,
+    **kwargs: Any,
+) -> Any:
+    """Call an ``agent.submit``-style function with one retry and telemetry.
+
+    Success is passed through unchanged.  On failure, the exception is logged
+    with the ``agent.submit:fail`` cause code, retried once with jitter, and
+    then re-raised if the retry also fails so callers still receive the
+    original failure semantics.
+    """
+
+    attempts = retries + 1
+    last_error: Optional[BaseException] = None
+    for attempt in range(1, attempts + 1):
+        try:
+            result = submit(*args, **kwargs)
+            if attempt > 1:
+                _structured_log(
+                    logging.INFO,
+                    "agent_submit_retry_recovered",
+                    cause_code="agent.submit:ok_after_retry",
+                    attempt=attempt,
+                    max_attempts=attempts,
+                )
+            return result
+        except Exception as exc:  # pragma: no cover - exercised by callers
+            last_error = exc
+            _structured_log(
+                logging.WARNING if attempt < attempts else logging.ERROR,
+                "agent_submit_failed",
+                cause_code="agent.submit:fail",
+                detail=str(exc),
+                attempt=attempt,
+                max_attempts=attempts,
+                exception_type=type(exc).__name__,
+            )
+            if attempt >= attempts:
+                break
+            time.sleep(random.uniform(0.0, jitter_seconds))
+
+    assert last_error is not None
+    raise last_error
