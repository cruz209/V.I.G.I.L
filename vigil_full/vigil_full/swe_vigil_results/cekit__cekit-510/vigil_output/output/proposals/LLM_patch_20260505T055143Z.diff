diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,91 @@
+import json
+import logging
+import random
+import time
+
+
+_AGENT_LOGGER = logging.getLogger(__name__)
+
+
+def _structured_agent_event(event, **fields):
+    """Emit a structured agent event without disrupting the caller.
+
+    Recent RBT diagnosis identified agent.submit failures as the primary thorn.
+    This helper gives submit paths consistent cause codes and payload shape while
+    remaining safe if logging configuration is minimal.
+    """
+    record = {"event": event, **fields}
+    try:
+        return json.dumps(record, sort_keys=True, default=str)
+    except TypeError:
+        safe_record = {key: str(value) for key, value in record.items()}
+        return json.dumps(safe_record, sort_keys=True)
+
+
+def submit_with_observability(submit_callable, *args, retries=1, jitter_seconds=0.25, **kwargs):
+    """Call an agent submit function with structured logging and one retry.
+
+    Args:
+        submit_callable: Callable that performs the submit operation.
+        *args: Positional arguments forwarded to the submit callable.
+        retries: Number of retries after the initial failure. Defaults to one,
+            matching the RBT hardening rule for tool-call failures.
+        jitter_seconds: Upper bound for random retry jitter.
+        **kwargs: Keyword arguments forwarded to the submit callable.
+
+    Returns:
+        The return value of ``submit_callable``.
+
+    Raises:
+        Re-raises the final exception after logging a structured failure with
+        cause_code="agent.submit:fail".
+    """
+    if not callable(submit_callable):
+        raise TypeError("submit_callable must be callable")
+
+    attempts = max(0, int(retries)) + 1
+    callable_name = getattr(submit_callable, "__name__", submit_callable.__class__.__name__)
+
+    for attempt in range(1, attempts + 1):
+        try:
+            result = submit_callable(*args, **kwargs)
+            _AGENT_LOGGER.info(
+                _structured_agent_event(
+                    "agent.submit.ok",
+                    cause_code="agent.submit:ok",
+                    callable=callable_name,
+                    attempt=attempt,
+                    max_attempts=attempts,
+                )
+            )
+            return result
+        except Exception as exc:
+            final_attempt = attempt >= attempts
+            _AGENT_LOGGER.warning(
+                _structured_agent_event(
+                    "agent.submit.fail",
+                    cause_code="agent.submit:fail",
+                    callable=callable_name,
+                    attempt=attempt,
+                    max_attempts=attempts,
+                    retrying=not final_attempt,
+                    error_type=exc.__class__.__name__,
+                    error=str(exc),
+                ),
+                exc_info=final_attempt,
+            )
+            if final_attempt:
+                raise
+            time.sleep(random.uniform(0, max(0.0, float(jitter_seconds))))
+
