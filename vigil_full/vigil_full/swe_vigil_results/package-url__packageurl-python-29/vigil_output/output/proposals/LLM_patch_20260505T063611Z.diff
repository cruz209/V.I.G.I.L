diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,0 +1,76 @@
+import json
+import logging
+import random
+import time
+from typing import Any, Callable, Dict, Optional
+
+
+LOGGER = logging.getLogger(__name__)
+
+
+def log_structured_event(
+    *,
+    event: str,
+    status: str,
+    cause_code: str,
+    details: Optional[Dict[str, Any]] = None,
+) -> None:
+    """Emit a structured agent event for reliability diagnostics.
+
+    RBT reflection identified ``agent.submit:fail`` as the primary thorn.  This
+    helper keeps failure reports machine-readable so future log processing can
+    attribute failures by cause code instead of relying on free-form messages.
+    """
+
+    payload: Dict[str, Any] = {
+        "event": event,
+        "status": status,
+        "cause_code": cause_code,
+        "details": details or {},
+    }
+    log_method = LOGGER.error if status == "fail" else LOGGER.info
+    log_method("agent_event=%s", json.dumps(payload, sort_keys=True, default=str))
+
+
+def submit_with_observability(
+    submit_callable: Callable[..., Any],
+    *args: Any,
+    cause_code: str = "agent.submit",
+    retry_once: bool = True,
+    jitter_seconds: float = 0.25,
+    **kwargs: Any,
+) -> Any:
+    """Run an agent submit call with structured logging and one jittered retry.
+
+    The wrapper preserves successful submit behavior while trimming the observed
+    ``agent.submit:fail`` thorn: failures are surfaced with a stable cause code
+    and, when enabled, retried once after a small randomized delay.
+    """
+
+    max_attempts = 2 if retry_once else 1
+    last_error: Optional[BaseException] = None
+
+    for attempt in range(1, max_attempts + 1):
+        try:
+            result = submit_callable(*args, **kwargs)
+            log_structured_event(
+                event="agent.submit",
+                status="ok",
+                cause_code=cause_code,
+                details={"attempt": attempt, "retry_once": retry_once},
+            )
+            return result
+        except Exception as exc:  # pragma: no cover - preserves original error
+            last_error = exc
+            log_structured_event(
+                event="agent.submit",
+                status="fail",
+                cause_code=f"{cause_code}:fail",
+                details={"attempt": attempt, "error": repr(exc)},
+            )
+            if attempt < max_attempts:
+                time.sleep(random.uniform(0.0, jitter_seconds))
+
+    assert last_error is not None
+    raise last_error
