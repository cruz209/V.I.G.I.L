diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -0,0 +1,98 @@
+"""Agent observability helpers.
+
+This module-level utility is intentionally dependency-light so submission
+failures can always be surfaced as structured events.  It is safe to import
+from existing agent code and can be used around agent.submit/tool-call paths.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import random
+import time
+from functools import wraps
+from typing import Any, Callable, Dict, Optional, TypeVar
+
+
+_F = TypeVar("_F", bound=Callable[..., Any])
+LOGGER = logging.getLogger(__name__)
+
+
+def log_structured_error(
+    *,
+    cause_code: str,
+    message: str,
+    exc: Optional[BaseException] = None,
+    **fields: Any,
+) -> Dict[str, Any]:
+    """Log and return a structured error payload for failing agent paths.
+
+    The recent RBT diagnosis identified ``agent.submit:fail`` as the top thorn.
+    Emitting a stable cause code makes submit failures easier to count, alert on,
+    and correlate with retry behavior.
+    """
+
+    payload: Dict[str, Any] = {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "message": message,
+        "retryable": fields.pop("retryable", True),
+    }
+    if exc is not None:
+        payload["exception_type"] = exc.__class__.__name__
+        payload["exception"] = str(exc)
+    payload.update(fields)
+
+    LOGGER.error("agent structured error: %s", json.dumps(payload, sort_keys=True))
+    return payload
+
+
+def validate_submit_payload(payload: Any) -> None:
+    """Validate a submit payload before calling downstream submit APIs.
+
+    Raises ``ValueError`` with a structured log entry if the payload is absent or
+    obviously malformed.  This catches local mistakes before they become opaque
+    ``agent.submit`` failures.
+    """
+
+    if payload is None:
+        log_structured_error(
+            cause_code="agent.submit.validation.empty_payload",
+            message="submit payload is required",
+            retryable=False,
+        )
+        raise ValueError("submit payload is required")
+
+    if isinstance(payload, dict) and not payload:
+        log_structured_error(
+            cause_code="agent.submit.validation.empty_mapping",
+            message="submit payload mapping is empty",
+            retryable=False,
+        )
+        raise ValueError("submit payload mapping is empty")
+
+
+def retry_once_with_jitter(
+    *,
+    cause_code: str,
+    base_delay_seconds: float = 0.2,
+) -> Callable[[_F], _F]:
+    """Retry a failing operation once and log both failure attempts.
+
+    This decorator is designed for submit/tool-call boundaries.  It keeps the
+    successful behavior unchanged while adding a single bounded retry for
+    transient failures and structured observability for persistent failures.
+    """
+
+    def decorator(func: _F) -> _F:
+        @wraps(func)
+        def wrapper(*args: Any, **kwargs: Any) -> Any:
+            try:
+                return func(*args, **kwargs)
+            except Exception as first_error:  # pragma: no cover - passthrough
+                log_structured_error(
+                    cause_code=f"{cause_code}.first_attempt",
+                    message="operation failed; retrying once with jitter",
+                    exc=first_error,
+                    retryable=True,
+                )
+                time.sleep(base_delay_seconds + random.uniform(0, base_delay_seconds))
+                try:
+                    return func(*args, **kwargs)
+                except Exception as second_error:
+                    log_structured_error(
+                        cause_code=f"{cause_code}.retry_failed",
+                        message="operation failed after retry",
+                        exc=second_error,
+                        retryable=False,
+                    )
+                    raise
+
+        return wrapper  # type: ignore[return-value]
+
+    return decorator
