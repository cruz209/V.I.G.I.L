diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,0 +1,82 @@
+import json as _rbt_json
+import logging as _rbt_logging
+import random as _rbt_random
+import time as _rbt_time
+from typing import Any as _RbtAny, Callable as _RbtCallable, Dict as _RbtDict, Optional as _RbtOptional
+
+
+_RBT_LOGGER = _rbt_logging.getLogger(__name__)
+
+
+def _rbt_structured_error(
+    *,
+    cause_code: str,
+    exc: BaseException,
+    attempt: int,
+    retries: int,
+    context: _RbtOptional[_RbtDict[str, _RbtAny]] = None,
+) -> _RbtDict[str, _RbtAny]:
+    """Build a stable structured error payload for agent failure paths.
+
+    The recent RBT reflection identified ``agent.submit`` failures as the top
+    thorn.  This helper gives failing paths a consistent cause code and enough
+    retry metadata to make future log diagnosis actionable while avoiding
+    accidental serialization failures from arbitrary exception/context values.
+    """
+    return {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "attempt": attempt,
+        "retries": retries,
+        "exception_type": type(exc).__name__,
+        "message": str(exc),
+        "context": context or {},
+    }
+
+
+def _rbt_log_error(
+    payload: _RbtDict[str, _RbtAny],
+    logger: _RbtOptional[_rbt_logging.Logger] = None,
+) -> None:
+    """Log structured errors without letting logging failures mask root cause."""
+    target = logger or _RBT_LOGGER
+    try:
+        target.error(_rbt_json.dumps(payload, sort_keys=True, default=str))
+    except Exception:  # pragma: no cover - defensive logging fallback
+        target.error("agent.error cause_code=%s payload=%r", payload.get("cause_code"), payload)
+
+
+def submit_with_observability(
+    submit_fn: _RbtCallable[..., _RbtAny],
+    *args: _RbtAny,
+    logger: _RbtOptional[_rbt_logging.Logger] = None,
+    retries: int = 1,
+    jitter_seconds: float = 0.25,
+    context: _RbtOptional[_RbtDict[str, _RbtAny]] = None,
+    **kwargs: _RbtAny,
+) -> _RbtAny:
+    """Call an agent submit function with one retry and structured logging.
+
+    Use this wrapper at ``agent.submit`` call sites to trim the observed
+    ``agent.submit:fail`` thorn: failures are surfaced with a cause code, and
+    transient errors are retried once with jitter before the original exception
+    is re-raised.
+    """
+    if retries < 0:
+        raise ValueError("retries must be >= 0")
+
+    attempt = 0
+    while True:
+        try:
+            return submit_fn(*args, **kwargs)
+        except Exception as exc:
+            payload = _rbt_structured_error(
+                cause_code="agent.submit.fail",
+                exc=exc,
+                attempt=attempt,
+                retries=retries,
+                context=context,
+            )
+            _rbt_log_error(payload, logger)
+            if attempt >= retries:
+                raise
+            attempt += 1
+            _rbt_time.sleep(_rbt_random.uniform(0.0, max(0.0, jitter_seconds)))
+
