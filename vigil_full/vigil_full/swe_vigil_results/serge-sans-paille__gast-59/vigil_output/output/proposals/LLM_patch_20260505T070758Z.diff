--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,77 @@
+import json
+import logging
+import random
+import time
+
+
+LOGGER = logging.getLogger(__name__)
+
+
+def log_structured_error(cause_code, exc, **context):
+    """Emit a machine-readable error event for thorn diagnosis.
+
+    The recent RBT diagnosis identified ``agent.submit:fail`` as the top thorn.
+    Keeping error records structured lets future log processing distinguish the
+    failing path, exception type, and useful context without scraping free-form
+    messages.
+    """
+    payload = {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "exception_type": type(exc).__name__,
+        "error": str(exc),
+        "context": context,
+    }
+    LOGGER.error("%s", json.dumps(payload, sort_keys=True, default=str), exc_info=True)
+
+
+def retry_once_with_jitter(operation, *, cause_code, min_delay=0.05, max_delay=0.25, **context):
+    """Run an operation and retry once after jitter when it fails.
+
+    This helper is intentionally small and dependency-free so submit paths can
+    wrap tool/API calls without changing their public behavior.  On both the
+    initial failure and any retry failure it emits a structured cause code for
+    later EmoBank/RBT analysis.
+    """
+    try:
+        return operation()
+    except Exception as first_error:
+        log_structured_error(cause_code, first_error, attempt=1, **context)
+        time.sleep(random.uniform(min_delay, max_delay))
+        try:
+            return operation()
+        except Exception as retry_error:
+            log_structured_error(cause_code, retry_error, attempt=2, **context)
+            raise
+
