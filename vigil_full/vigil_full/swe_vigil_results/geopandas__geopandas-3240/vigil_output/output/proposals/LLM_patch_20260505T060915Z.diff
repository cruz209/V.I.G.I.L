diff --git a/agent.py b/agent.py
index 7d1c0a1..4f6c2b8 100644
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,75 @@
+import json
+import logging
+import random
+import time
+from typing import Any, Callable, Dict, Optional
+
+_SUBMIT_LOGGER = logging.getLogger("robin_b.agent.submit")
+
+
+def _structured_error_payload(
+    *,
+    cause_code: str,
+    exc: BaseException,
+    attempt: int,
+    max_attempts: int,
+    context: Optional[Dict[str, Any]] = None,
+) -> Dict[str, Any]:
+    """Return a machine-readable error record for submit failures.
+
+    The RBT review identified `agent.submit:fail` as the current thorn.  Keeping
+    this payload small and JSON-serialisable makes failures visible in logs while
+    avoiding accidental leakage of large request/response bodies.
+    """
+    return {
+        "event": "agent.submit.error",
+        "cause_code": cause_code,
+        "attempt": attempt,
+        "max_attempts": max_attempts,
+        "exception_type": type(exc).__name__,
+        "message": str(exc),
+        "context": context or {},
+    }
+
+
+def submit_with_observability(
+    submit_callable: Callable[..., Any],
+    *args: Any,
+    cause_code: str = "agent.submit:fail",
+    context: Optional[Dict[str, Any]] = None,
+    max_attempts: int = 2,
+    base_delay_seconds: float = 0.25,
+    **kwargs: Any,
+) -> Any:
+    """Call an agent submit function with one jittered retry and structured logs.
+
+    Use this wrapper at submit call sites so transient failures are retried once
+    and persistent failures include a stable cause code for downstream diagnosis.
+    """
+    if max_attempts < 1:
+        raise ValueError("max_attempts must be at least 1")
+
+    last_error: Optional[BaseException] = None
+    for attempt in range(1, max_attempts + 1):
+        try:
+            return submit_callable(*args, **kwargs)
+        except Exception as exc:  # pragma: no cover - exercised by callers
+            last_error = exc
+            payload = _structured_error_payload(
+                cause_code=cause_code,
+                exc=exc,
+                attempt=attempt,
+                max_attempts=max_attempts,
+                context=context,
+            )
+            _SUBMIT_LOGGER.warning(json.dumps(payload, sort_keys=True))
+            if attempt >= max_attempts:
+                break
+            jitter = random.uniform(0.0, base_delay_seconds)
+            time.sleep(base_delay_seconds + jitter)
+
+    assert last_error is not None
+    raise last_error
+
