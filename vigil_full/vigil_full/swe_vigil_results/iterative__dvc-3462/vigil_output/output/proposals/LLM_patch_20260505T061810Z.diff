+def submit_with_structured_retry(submit_callable, *args, logger=None, retries=1, jitter_seconds=0.25, **kwargs):
+    """Call an agent.submit-like function with structured logging and one retry.
+
+    Recent RBT diagnosis identified agent.submit failures as the dominant thorn.
+    This utility centralizes defensive handling for submit paths without changing
+    successful behavior: the callable is invoked normally, and only exceptions
+    trigger structured error logging plus a bounded retry.
+    """
+    import json
+    import logging
+    import random
+    import time
+
+    active_logger = logger or logging.getLogger(__name__)
+    max_attempts = max(1, int(retries) + 1)
+
+    for attempt in range(1, max_attempts + 1):
+        try:
+            result = submit_callable(*args, **kwargs)
+            active_logger.info(
+                json.dumps(
+                    {
+                        "event": "agent.submit",
+                        "status": "ok",
+                        "attempt": attempt,
+                        "cause_code": "agent.submit.ok",
+                    },
+                    sort_keys=True,
+                )
+            )
+            return result
+        except Exception as exc:
+            active_logger.error(
+                json.dumps(
+                    {
+                        "event": "agent.submit",
+                        "status": "fail",
+                        "attempt": attempt,
+                        "max_attempts": max_attempts,
+                        "cause_code": "agent.submit.exception",
+                        "error_type": type(exc).__name__,
+                        "error": str(exc),
+                    },
+                    sort_keys=True,
+                ),
+                exc_info=True,
+            )
+            if attempt >= max_attempts:
+                raise
+            time.sleep(random.uniform(0, max(0.0, float(jitter_seconds))))
+
+
 