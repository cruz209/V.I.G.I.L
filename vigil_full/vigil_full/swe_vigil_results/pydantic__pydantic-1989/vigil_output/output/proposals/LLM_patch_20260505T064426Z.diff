diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,0 +1,54 @@
+import json as _rbt_json
+import logging as _rbt_logging
+import time as _rbt_time
+import traceback as _rbt_traceback
+
+
+_RBT_LOGGER = _rbt_logging.getLogger("robin_b.agent")
+
+
+def log_structured_failure(cause_code, *, exc=None, **context):
+    """Emit structured diagnostics for agent failures.
+
+    Recent RBT analysis identified ``agent.submit:fail`` as the primary thorn.
+    This helper standardizes failure telemetry so submit-path errors have a
+    stable cause code, timestamp, exception metadata, and optional contextual
+    fields without changing successful execution behavior.
+    """
+    event = {
+        "event": "agent.failure",
+        "cause": str(cause_code or "unknown"),
+        "ts": _rbt_time.strftime("%Y-%m-%dT%H:%M:%SZ", _rbt_time.gmtime()),
+    }
+    if context:
+        event["context"] = {str(key): value for key, value in context.items()}
+    if exc is not None:
+        event["exception"] = {
+            "type": type(exc).__name__,
+            "message": str(exc),
+            "traceback": _rbt_traceback.format_exception(type(exc), exc, exc.__traceback__),
+        }
+
+    try:
+        payload = _rbt_json.dumps(event, default=str, sort_keys=True)
+    except Exception:
+        payload = repr(event)
+    _RBT_LOGGER.error(payload)
+    return event
+
+
+def guarded_submit(submit_callable, *args, **kwargs):
+    """Call a submit function with standardized ``agent.submit`` telemetry.
+
+    Use this wrapper around submit-path call sites to preserve the successful
+    behavior while making failures diagnosable via a consistent
+    ``agent.submit:fail`` cause code.
+    """
+    try:
+        return submit_callable(*args, **kwargs)
+    except Exception as exc:
+        log_structured_failure(
+            "agent.submit:fail",
+            exc=exc,
+            submit_callable=getattr(submit_callable, "__name__", repr(submit_callable)),
+        )
+        raise
+
