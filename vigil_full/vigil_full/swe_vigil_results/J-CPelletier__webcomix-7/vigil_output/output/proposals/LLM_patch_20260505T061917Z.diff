--- a/agent.py
+++ b/agent.py
@@ -1,0 +1,91 @@
+"""Agent reliability helpers.
+
+This module-level block adds lightweight observability and retry primitives for
+agent submission paths.  It is intentionally dependency-free so it can be used
+from existing submit wrappers without changing runtime requirements.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import random
+import time
+from collections.abc import Callable, Mapping
+from typing import Any, TypeVar
+
+
+_T = TypeVar("_T")
+_AGENT_LOGGER = logging.getLogger("agent")
+
+
+def log_structured_error(
+    *,
+    cause_code: str,
+    message: str,
+    exc: BaseException | None = None,
+    **fields: Any,
+) -> None:
+    """Log a machine-readable error for agent failure paths.
+
+    The recent RBT diagnosis identified ``agent.submit:fail`` as the primary
+    thorn.  Structured cause codes make future failures searchable in logs and
+    allow the reflection loop to distinguish submission failures from unrelated
+    exceptions.
+    """
+
+    payload = {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "message": message,
+        **fields,
+    }
+    if exc is not None:
+        payload["exception_type"] = type(exc).__name__
+        payload["exception"] = str(exc)
+
+    _AGENT_LOGGER.error(json.dumps(payload, sort_keys=True), exc_info=exc is not None)
+
+
+def validate_agent_submit_payload(payload: Mapping[str, Any] | None) -> None:
+    """Validate the payload sent to ``agent.submit`` before the call is made.
+
+    Raises:
+        ValueError: if the payload is missing or contains obviously invalid
+            values.  Callers should catch this and surface the structured
+            ``agent.submit.validation`` cause code via ``log_structured_error``.
+    """
+
+    if payload is None:
+        raise ValueError("agent.submit payload is required")
+    if not isinstance(payload, Mapping):
+        raise ValueError("agent.submit payload must be a mapping")
+    if not payload:
+        raise ValueError("agent.submit payload must not be empty")
+
+
+def retry_once_with_jitter(
+    operation: Callable[[], _T],
+    *,
+    cause_code: str = "agent.submit.fail",
+    base_delay_seconds: float = 0.25,
+    jitter_seconds: float = 0.25,
+) -> _T:
+    """Run ``operation`` and retry once after a small jittered delay.
+
+    This implements the adaptive rule from the latest RBT reflection: when a
+    tool/submission call fails, surface a structured error and auto-retry once
+    with jitter.  The final exception is re-raised so callers retain existing
+    failure semantics.
+    """
+
+    try:
+        return operation()
+    except Exception as first_exc:
+        delay = max(0.0, base_delay_seconds + random.uniform(0.0, jitter_seconds))
+        log_structured_error(
+            cause_code=cause_code,
+            message="operation failed; retrying once with jitter",
+            exc=first_exc,
+            retry_attempt=1,
+            retry_delay_seconds=round(delay, 3),
+        )
+        time.sleep(delay)
+
+    try:
+        return operation()
+    except Exception as final_exc:
+        log_structured_error(
+            cause_code=cause_code,
+            message="operation failed after retry",
+            exc=final_exc,
+            retry_attempt=2,
+        )
+        raise
