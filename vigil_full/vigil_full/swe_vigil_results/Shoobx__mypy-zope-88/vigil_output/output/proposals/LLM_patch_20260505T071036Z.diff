diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,91 @@
+import json
+import logging
+import random
+import time
+from functools import wraps
+
+
+LOGGER = logging.getLogger(__name__)
+
+
+def _structured_agent_error(cause_code, exc, *, attempt=None, max_attempts=None, **context):
+    """Log agent failures with a stable cause code for RBT diagnosis.
+
+    The event shape is intentionally simple JSON so downstream log readers can
+    group failures like ``agent.submit:fail`` without scraping free-form text.
+    """
+    event = {
+        "event": "agent.error",
+        "cause": cause_code,
+        "error_type": type(exc).__name__,
+        "error": str(exc),
+    }
+    if attempt is not None:
+        event["attempt"] = attempt
+    if max_attempts is not None:
+        event["max_attempts"] = max_attempts
+    event.update({k: v for k, v in context.items() if v is not None})
+    LOGGER.error(json.dumps(event, sort_keys=True), exc_info=True)
+
+
+def retry_once_with_jitter(cause_code, *, base_delay=0.25, jitter=0.25):
+    """Retry a fragile operation once and emit structured failure telemetry.
+
+    Use for paths such as agent.submit where a transient tool/API failure should
+    be visible to logs and retried a single time before surfacing the exception.
+    """
+
+    def decorator(func):
+        @wraps(func)
+        def wrapper(*args, **kwargs):
+            max_attempts = 2
+            for attempt in range(1, max_attempts + 1):
+                try:
+                    return func(*args, **kwargs)
+                except Exception as exc:
+                    _structured_agent_error(
+                        cause_code,
+                        exc,
+                        attempt=attempt,
+                        max_attempts=max_attempts,
+                        function=getattr(func, "__name__", None),
+                    )
+                    if attempt >= max_attempts:
+                        raise
+                    time.sleep(base_delay + random.random() * jitter)
+
+        return wrapper
+
+    return decorator
+
+
+def submit_with_observability(submit_callable, *args, **kwargs):
+    """Call ``submit_callable`` with one retry and structured error logging.
+
+    This helper is deliberately small so existing submit call sites can be
+    migrated incrementally:
+
+        result = submit_with_observability(agent.submit, payload)
+
+    It preserves the successful return value, retries one transient failure with
+    jitter, and re-raises after the final attempt so callers keep existing error
+    semantics while logs gain the ``agent.submit:fail`` cause code.
+    """
+    max_attempts = 2
+    for attempt in range(1, max_attempts + 1):
+        try:
+            return submit_callable(*args, **kwargs)
+        except Exception as exc:
+            _structured_agent_error(
+                "agent.submit:fail",
+                exc,
+                attempt=attempt,
+                max_attempts=max_attempts,
+                callable=getattr(submit_callable, "__name__", repr(submit_callable)),
+            )
+            if attempt >= max_attempts:
+                raise
+            time.sleep(0.25 + random.random() * 0.25)
+
