diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,56 @@
+import json
+import logging
+import random
+import time
+
+_ROBIN_B_LOGGER = logging.getLogger(__name__)
+
+
+def submit_with_observability(submit_fn, *args, retries=1, jitter_seconds=0.25, **kwargs):
+    """Call an agent submit function with structured logging and one retry.
+
+    Recent RBT diagnosis identified ``agent.submit:fail`` as the primary thorn.
+    This helper preserves the existing submit behavior on success while making
+    failures observable and retrying transient errors once with small jitter.
+    """
+    attempts = max(1, int(retries) + 1)
+    last_error = None
+
+    for attempt in range(1, attempts + 1):
+        try:
+            result = submit_fn(*args, **kwargs)
+            _log_submit_event(
+                level=logging.INFO,
+                event="agent.submit",
+                status="ok",
+                attempt=attempt,
+                attempts=attempts,
+            )
+            return result
+        except Exception as exc:
+            last_error = exc
+            _log_submit_event(
+                level=logging.ERROR,
+                event="agent.submit",
+                status="fail",
+                attempt=attempt,
+                attempts=attempts,
+                error=exc,
+            )
+            if attempt < attempts:
+                time.sleep(random.uniform(0, max(0.0, jitter_seconds)))
+
+    raise last_error
+
+
+def _log_submit_event(level, event, status, attempt, attempts, error=None):
+    """Emit structured submit telemetry with stable cause codes."""
+    payload = {
+        "event": event,
+        "status": status,
+        "cause": f"{event}:{status}",
+        "attempt": attempt,
+        "attempts": attempts,
+    }
+    if error is not None:
+        payload["error_type"] = type(error).__name__
+        payload["error"] = str(error)
+    _ROBIN_B_LOGGER.log(level, json.dumps(payload, sort_keys=True))
+
