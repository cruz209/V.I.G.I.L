--- a/agent.py
+++ b/agent.py
@@ -0,0 +1,86 @@
+"""Agent reliability helpers.
+
+This module-level utility adds structured observability and a one-shot retry for
+submission paths. It is intentionally dependency-light so it can be used from
+existing agent.submit call sites without changing their public behavior.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import random
+import time
+from typing import Any, Callable, TypeVar
+
+
+_T = TypeVar("_T")
+_LOGGER = logging.getLogger(__name__)
+
+
+def log_structured_event(event: str, *, cause_code: str, **fields: Any) -> None:
+    """Emit a structured agent event with a stable cause code.
+
+    The RBT diagnosis identified ``agent.submit:fail`` as the active thorn. A
+    stable JSON log shape makes future failures searchable while preserving
+    current successful behavior.
+    """
+
+    payload = {
+        "event": event,
+        "cause_code": cause_code,
+        **fields,
+    }
+    try:
+        message = json.dumps(payload, sort_keys=True, default=str)
+    except TypeError:
+        payload = {
+            "event": event,
+            "cause_code": cause_code,
+            "serialization_error": True,
+            "fields": repr(fields),
+        }
+        message = json.dumps(payload, sort_keys=True)
+    _LOGGER.info(message)
+
+
+def call_with_submit_retry(
+    operation: Callable[..., _T],
+    *args: Any,
+    cause_code: str = "agent.submit:fail",
+    retry_delay_seconds: float = 0.25,
+    **kwargs: Any,
+) -> _T:
+    """Run a submit operation, retrying once with jitter on failure.
+
+    Existing call sites can wrap ``agent.submit`` or equivalent submit functions
+    with this helper to gain structured error logs and a single bounded retry.
+    If both attempts fail, the original exception semantics are preserved by
+    re-raising the second exception after logging it.
+    """
+
+    try:
+        result = operation(*args, **kwargs)
+        log_structured_event(
+            "agent.submit.ok",
+            cause_code="agent.submit:ok",
+            operation=getattr(operation, "__name__", repr(operation)),
+            attempt=1,
+        )
+        return result
+    except Exception as first_error:
+        log_structured_event(
+            "agent.submit.error",
+            cause_code=cause_code,
+            operation=getattr(operation, "__name__", repr(operation)),
+            attempt=1,
+            error_type=type(first_error).__name__,
+            error=str(first_error),
+            retrying=True,
+        )
+
+    sleep_for = retry_delay_seconds + random.uniform(0.0, retry_delay_seconds)
+    time.sleep(sleep_for)
+
+    try:
+        result = operation(*args, **kwargs)
+        log_structured_event(
+            "agent.submit.ok",
+            cause_code="agent.submit:ok",
+            operation=getattr(operation, "__name__", repr(operation)),
+            attempt=2,
+        )
+        return result
+    except Exception as second_error:
+        log_structured_event(
+            "agent.submit.error",
+            cause_code=cause_code,
+            operation=getattr(operation, "__name__", repr(operation)),
+            attempt=2,
+            error_type=type(second_error).__name__,
+            error=str(second_error),
+            retrying=False,
+        )
+        raise
