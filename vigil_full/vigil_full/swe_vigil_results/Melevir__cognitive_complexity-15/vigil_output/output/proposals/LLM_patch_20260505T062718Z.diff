@@ -1,3 +1,67 @@
+import json
+import logging
+import random
+import time
+
+logger = logging.getLogger(__name__)
+
+
+class AgentSubmitError(RuntimeError):
+    """Raised when agent.submit cannot complete after retry."""
+
+
+def _log_structured_event(level, cause, message, **fields):
+    """Emit structured logs for agent failures and observability signals.
+
+    The RBT reflection identified agent.submit failures as the top thorn. This
+    helper keeps failure reports machine-readable while preserving existing
+    behavior for successful shell execution paths.
+    """
+    payload = {
+        "cause": cause,
+        "message": message,
+        **fields,
+    }
+    logger.log(level, json.dumps(payload, sort_keys=True, default=str))
+
+
+def submit_with_observability(submit_callable, *args, retry_once=True, jitter_seconds=0.25, **kwargs):
+    """Call agent.submit with structured errors and one jittered retry.
+
+    Use this wrapper at agent.submit call sites to surface clear cause codes and
+    automatically retry transient failures once, as requested by the latest RBT
+    diagnosis.
+    """
+    attempts = 2 if retry_once else 1
+    last_error = None
+
+    for attempt in range(1, attempts + 1):
+        started = time.monotonic()
+        try:
+            result = submit_callable(*args, **kwargs)
+            _log_structured_event(
+                logging.INFO,
+                "agent.submit:ok",
+                "agent submit completed",
+                attempt=attempt,
+                elapsed_ms=round((time.monotonic() - started) * 1000, 2),
+            )
+            return result
+        except Exception as exc:  # pragma: no cover - defensive wrapper
+            last_error = exc
+            _log_structured_event(
+                logging.ERROR,
+                "agent.submit:fail",
+                "agent submit failed",
+                attempt=attempt,
+                retrying=attempt < attempts,
+                error_type=type(exc).__name__,
+                error=str(exc),
+                elapsed_ms=round((time.monotonic() - started) * 1000, 2),
+            )
+            if attempt < attempts:
+                time.sleep(random.uniform(0, jitter_seconds))
+
+    raise AgentSubmitError("agent.submit failed after retry") from last_error
+
