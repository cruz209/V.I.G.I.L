diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,47 @@
+import json
+import logging
+import random
+import time
+from typing import Any, Callable, Dict, Optional, TypeVar
+
+T = TypeVar("T")
+
+
+def log_structured_error(
+    logger: logging.Logger,
+    *,
+    cause_code: str,
+    message: str,
+    exc: Optional[BaseException] = None,
+    **context: Any,
+) -> None:
+    """Emit a machine-readable error record for failing agent paths."""
+    payload: Dict[str, Any] = {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "message": message,
+        "context": context,
+    }
+    if exc is not None:
+        payload["exception_type"] = type(exc).__name__
+        payload["exception"] = str(exc)
+    logger.error(json.dumps(payload, sort_keys=True))
+
+
+def submit_with_observability(
+    submit_fn: Callable[..., T],
+    *args: Any,
+    logger: Optional[logging.Logger] = None,
+    retries: int = 1,
+    base_delay_seconds: float = 0.25,
+    **kwargs: Any,
+) -> T:
+    """Call agent.submit-like functions with one jittered retry and structured errors."""
+    active_logger = logger or logging.getLogger(__name__)
+    attempts = retries + 1
+    for attempt in range(1, attempts + 1):
+        try:
+            return submit_fn(*args, **kwargs)
+        except Exception as exc:
+            log_structured_error(
+                active_logger,
+                cause_code="agent.submit.fail",
+                message="agent submit failed",
+                exc=exc,
+                attempt=attempt,
+                max_attempts=attempts,
+            )
+            if attempt >= attempts:
+                raise
+            time.sleep(base_delay_seconds + random.uniform(0, base_delay_seconds))
+
