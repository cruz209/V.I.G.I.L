diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,78 @@
+import json
+import logging
+import random
+import time
+
+logger = logging.getLogger(__name__)
+
+
+class AgentSubmitError(RuntimeError):
+    """Raised when agent.submit fails after retry with structured context."""
+
+
+def _safe_json_log(level, event, **fields):
+    """Emit structured JSON logs without letting logging failures mask root causes."""
+    payload = {"event": event, **fields}
+    try:
+        message = json.dumps(payload, sort_keys=True, default=str)
+    except Exception:
+        message = str(payload)
+    getattr(logger, level)(message)
+
+
+def submit_with_observability(submit_fn, *args, cause_code="agent.submit", retries=1, **kwargs):
+    """Call an agent submit function with one retry and structured failure logging.
+
+    Recent RBT diagnosis identified `agent.submit:fail` as the top thorn.  This
+    wrapper preserves successful submit behavior while making failures visible and
+    giving transient errors one jittered retry before surfacing a structured error.
+    """
+    attempts = max(1, int(retries) + 1)
+    last_error = None
+
+    for attempt in range(1, attempts + 1):
+        started = time.monotonic()
+        try:
+            result = submit_fn(*args, **kwargs)
+            _safe_json_log(
+                "info",
+                "agent_submit_ok",
+                cause_code=f"{cause_code}:ok",
+                attempt=attempt,
+                elapsed_ms=round((time.monotonic() - started) * 1000, 2),
+            )
+            return result
+        except Exception as exc:
+            last_error = exc
+            _safe_json_log(
+                "error",
+                "agent_submit_fail",
+                cause_code=f"{cause_code}:fail",
+                attempt=attempt,
+                attempts=attempts,
+                error_type=type(exc).__name__,
+                error=str(exc),
+                elapsed_ms=round((time.monotonic() - started) * 1000, 2),
+            )
+            if attempt < attempts:
+                time.sleep(random.uniform(0.05, 0.25))
+
+    raise AgentSubmitError(
+        f"{cause_code}:fail after {attempts} attempt(s): {last_error}"
+    ) from last_error
+
+
