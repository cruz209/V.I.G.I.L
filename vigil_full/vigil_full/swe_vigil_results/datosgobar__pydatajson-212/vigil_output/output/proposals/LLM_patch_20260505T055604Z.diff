diff --git a/agent.py b/agent.py
index 2b6f1a1..8f3d2c4 100644
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,84 @@
+import json
+import logging
+import random
+import time
+
+
+LOGGER = logging.getLogger(__name__)
+
+
+def _log_structured_agent_event(level, event, **fields):
+    """Emit machine-readable agent events with stable cause codes.
+
+    This keeps failures observable without changing existing submit behavior.
+    Callers can grep for ``agent.submit`` cause codes in logs/events.jsonl or
+    standard application logs when diagnosing recurring thorns.
+    """
+    record = {"event": event, **fields}
+    LOGGER.log(level, json.dumps(record, sort_keys=True, default=str))
+
+
+def submit_with_observability(submit_callable, *args, max_retries=1, retry_jitter_seconds=0.25, **kwargs):
+    """Run an agent submit callable with structured logging and one jittered retry.
+
+    The recent RBT diagnosis identified ``agent.submit:fail`` as the top thorn.
+    Wrapping submit paths with this helper preserves successful behavior while
+    surfacing structured errors and retrying transient failures once.
+    """
+    attempts = max_retries + 1
+    last_error = None
+
+    for attempt in range(1, attempts + 1):
+        try:
+            result = submit_callable(*args, **kwargs)
+            _log_structured_agent_event(
+                logging.INFO,
+                "agent.submit",
+                cause="agent.submit:ok",
+                attempt=attempt,
+                max_retries=max_retries,
+            )
+            return result
+        except Exception as exc:  # pragma: no cover - exercised by integration paths
+            last_error = exc
+            will_retry = attempt < attempts
+            _log_structured_agent_event(
+                logging.ERROR,
+                "agent.submit",
+                cause="agent.submit:fail",
+                attempt=attempt,
+                max_retries=max_retries,
+                will_retry=will_retry,
+                error_type=type(exc).__name__,
+                error=str(exc),
+            )
+            if will_retry:
+                time.sleep(random.uniform(0, retry_jitter_seconds))
+
+    raise last_error
+
