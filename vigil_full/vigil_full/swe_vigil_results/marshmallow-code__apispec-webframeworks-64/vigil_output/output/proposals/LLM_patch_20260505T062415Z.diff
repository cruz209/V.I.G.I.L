--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,55 @@
+import json
+import logging
+import random
+import time
+
+LOGGER = logging.getLogger(__name__)
+
+
+def log_structured_error(cause_code, exc, **context):
+    """Emit structured error details for agent failure paths.
+
+    The RBT review identified agent.submit failures as the top thorn.  This
+    helper keeps those failures observable without changing successful behavior.
+    """
+    event = {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "error_type": type(exc).__name__,
+        "error": str(exc),
+        "context": context,
+    }
+    LOGGER.error(json.dumps(event, sort_keys=True))
+
+
+def retry_once_with_jitter(operation, *, cause_code, jitter_seconds=0.25, **context):
+    """Run an operation and retry once after jitter on failure.
+
+    Args:
+        operation: Zero-argument callable to execute.
+        cause_code: Stable code used in structured logs, e.g. ``agent.submit``.
+        jitter_seconds: Maximum random delay before the retry.
+        **context: Extra diagnostic fields included in error logs.
+
+    Raises:
+        The final exception if both the first attempt and retry fail.
+    """
+    try:
+        return operation()
+    except Exception as first_exc:
+        log_structured_error(f"{cause_code}:fail", first_exc, attempt=1, **context)
+        time.sleep(random.uniform(0, jitter_seconds))
+        try:
+            return operation()
+        except Exception as second_exc:
+            log_structured_error(f"{cause_code}:fail", second_exc, attempt=2, **context)
+            raise
+
