--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,57 @@
+import json
+import logging
+import random
+import time
+from typing import Any, Callable, Dict, Optional
+
+
+LOGGER = logging.getLogger(__name__)
+
+
+class AgentSubmitError(RuntimeError):
+    """Structured error raised when agent.submit cannot complete."""
+
+    def __init__(self, message: str, *, cause_code: str, context: Optional[Dict[str, Any]] = None) -> None:
+        super().__init__(message)
+        self.cause_code = cause_code
+        self.context = context or {}
+
+
+def _log_structured_error(cause_code: str, message: str, **context: Any) -> None:
+    """Emit a machine-parseable error record for failure diagnosis."""
+    LOGGER.error(
+        "agent_error %s",
+        json.dumps(
+            {
+                "cause_code": cause_code,
+                "message": message,
+                "context": context,
+            },
+            sort_keys=True,
+            default=str,
+        ),
+    )
+
+
+def submit_with_observability(
+    submit_fn: Callable[..., Any],
+    *args: Any,
+    cause_code: str = "agent.submit:fail",
+    retry_jitter_seconds: float = 0.25,
+    **kwargs: Any,
+) -> Any:
+    """Run an agent submit operation with one jittered retry and structured logging.
+
+    Recent log reflection identified ``agent.submit`` as the top thorn. This helper
+    keeps the successful submit path unchanged while ensuring failures are visible
+    and transient submit errors get one bounded retry before surfacing a structured
+    exception to callers.
+    """
+    attempts = 2
+    for attempt in range(1, attempts + 1):
+        try:
+            return submit_fn(*args, **kwargs)
+        except Exception as exc:
+            _log_structured_error(cause_code, str(exc), attempt=attempt, max_attempts=attempts)
+            if attempt >= attempts:
+                raise AgentSubmitError(str(exc), cause_code=cause_code, context={"attempt": attempt}) from exc
+            time.sleep(random.uniform(0, retry_jitter_seconds))
+
