--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,61 @@
+import json
+import logging
+import random
+import time
+
+logger = logging.getLogger(__name__)
+
+
+def _structured_error(cause_code, exc, **context):
+    """Return a JSON-serializable structured error payload for agent failures."""
+    return {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "error_type": type(exc).__name__,
+        "error": str(exc),
+        "context": context,
+    }
+
+
+def _log_structured_error(cause_code, exc, **context):
+    """Log failures with stable cause codes for RBT/EmoBank diagnosis."""
+    logger.error(
+        "agent failure: %s",
+        json.dumps(_structured_error(cause_code, exc, **context), sort_keys=True),
+        exc_info=True,
+    )
+
+
+def submit_with_observability(submit_fn, *args, retries=1, jitter_seconds=0.25, **kwargs):
+    """Call agent.submit-like functions with structured logging and one retry.
+
+    Recent logs showed an ``agent.submit:fail`` thorn. This wrapper preserves the
+    existing submit behavior on success while surfacing stable diagnostics on
+    failure and retrying once with bounded jitter before re-raising.
+    """
+    attempt = 0
+    while True:
+        try:
+            result = submit_fn(*args, **kwargs)
+            logger.info(
+                "agent submit succeeded: %s",
+                json.dumps(
+                    {
+                        "event": "agent.submit",
+                        "status": "ok",
+                        "attempt": attempt + 1,
+                    },
+                    sort_keys=True,
+                ),
+            )
+            return result
+        except Exception as exc:
+            _log_structured_error(
+                "agent.submit:fail",
+                exc,
+                attempt=attempt + 1,
+                max_attempts=retries + 1,
+            )
+            if attempt >= retries:
+                raise
+            attempt += 1
+            time.sleep(random.uniform(0, jitter_seconds))
+
