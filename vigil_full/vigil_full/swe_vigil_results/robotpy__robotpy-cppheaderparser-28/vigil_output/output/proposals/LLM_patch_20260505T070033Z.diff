--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,42 @@
+import json
+import logging
+import time
+
+
+def _log_structured_error(cause_code, exc, **context):
+    """Emit machine-readable error telemetry for thorn diagnosis.
+
+    Recent RBT diagnosis identified `agent.submit:fail` as the top thorn.
+    Keep the helper dependency-light so failure paths can call it safely.
+    """
+    payload = {
+        "event": "agent.error",
+        "cause": cause_code,
+        "error_type": type(exc).__name__,
+        "error": str(exc),
+        "ts": time.time(),
+    }
+    if context:
+        payload["context"] = context
+    logging.getLogger(__name__).error(json.dumps(payload, sort_keys=True))
+
+
+def _submit_with_observability(submit_fn, *args, **kwargs):
+    """Run an agent submit callable with structured failure logging.
+
+    This preserves successful submit behavior while making failures diagnosable
+    with a stable `agent.submit:fail` cause code.
+    """
+    try:
+        return submit_fn(*args, **kwargs)
+    except Exception as exc:
+        _log_structured_error(
+            "agent.submit:fail",
+            exc,
+            submit_callable=getattr(submit_fn, "__name__", repr(submit_fn)),
+        )
+        raise
+
