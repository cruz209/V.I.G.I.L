diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,0 +1,67 @@
+def log_structured_agent_error(cause_code, exc, **context):
+    """Emit a structured, low-risk error event for agent failure paths.
+
+    The recent RBT diagnosis identified ``agent.submit:fail`` as the top thorn.
+    This helper gives submit/error paths a consistent JSON payload without
+    requiring global logging configuration changes. Callers can use it from an
+    ``except`` block, then retry or surface the error as appropriate.
+
+    Example:
+        try:
+            return submit(payload)
+        except Exception as exc:
+            log_structured_agent_error("agent.submit:fail", exc, payload_id=payload.id)
+            raise
+    """
+    import json
+    import logging
+    import time
+
+    logger = logging.getLogger(__name__)
+    safe_context = {}
+    for key, value in context.items():
+        try:
+            json.dumps(value)
+            safe_context[key] = value
+        except (TypeError, ValueError):
+            safe_context[key] = repr(value)
+
+    logger.error(
+        "agent_failure %s",
+        json.dumps(
+            {
+                "event": "agent_failure",
+                "cause_code": str(cause_code),
+                "error_type": type(exc).__name__,
+                "error": str(exc),
+                "context": safe_context,
+                "ts": time.time(),
+            },
+            sort_keys=True,
+        ),
+    )
+
+
+def retry_once_with_jitter(operation, *, cause_code="agent.submit:fail", logger_context=None):
+    """Run ``operation`` and retry once with jitter after a failure.
+
+    This is intentionally small and dependency-free so submit paths can adopt it
+    incrementally. The first failure is logged with a structured cause code; the
+    second failure is left for the caller to handle so existing behavior is not
+    silently swallowed.
+    """
+    import random
+    import time
+
+    try:
+        return operation()
+    except Exception as exc:
+        context = logger_context or {}
+        log_structured_agent_error(cause_code, exc, **context)
+        time.sleep(random.uniform(0.05, 0.2))
+        return operation()
+
