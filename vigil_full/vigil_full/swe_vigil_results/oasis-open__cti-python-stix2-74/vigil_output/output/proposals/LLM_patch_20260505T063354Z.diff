diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,82 @@
+"""Agent reliability helpers.
+
+This module-level utility keeps tool-submit failures observable and bounded.
+It is intentionally dependency-free so it can be reused by submit paths without
+changing their public behavior.
+"""
+
+import json
+import logging
+import random
+import time
+from typing import Any, Callable, Dict, Optional, TypeVar
+
+
+_SubmitResult = TypeVar("_SubmitResult")
+_LOGGER = logging.getLogger("robin_b.agent")
+
+
+def _structured_agent_error(
+    *,
+    cause_code: str,
+    error: BaseException,
+    attempt: int,
+    max_attempts: int,
+    extra: Optional[Dict[str, Any]] = None,
+) -> Dict[str, Any]:
+    """Return a stable, machine-readable error payload for agent failures."""
+    payload: Dict[str, Any] = {
+        "event": "agent.submit.error",
+        "cause_code": cause_code,
+        "attempt": attempt,
+        "max_attempts": max_attempts,
+        "error_type": type(error).__name__,
+        "error": str(error),
+    }
+    if extra:
+        payload["extra"] = extra
+    return payload
+
+
+def submit_with_observability(
+    submit_fn: Callable[..., _SubmitResult],
+    *args: Any,
+    cause_code: str = "agent.submit:fail",
+    retries: int = 1,
+    jitter_seconds: float = 0.25,
+    logger: Optional[logging.Logger] = None,
+    **kwargs: Any,
+) -> _SubmitResult:
+    """Run an agent submit callable with structured logging and one retry.
+
+    The recent RBT diagnosis identified ``agent.submit:fail`` as the active
+    thorn. This wrapper preserves successful submit behavior while adding:
+
+    * structured JSON error logs with a stable cause code;
+    * a bounded retry (default: one retry);
+    * small jitter before retrying to avoid immediate repeated failure.
+
+    Example:
+        result = submit_with_observability(agent.submit, payload)
+    """
+    active_logger = logger or _LOGGER
+    max_attempts = max(1, retries + 1)
+
+    for attempt in range(1, max_attempts + 1):
+        try:
+            return submit_fn(*args, **kwargs)
+        except Exception as exc:
+            payload = _structured_agent_error(
+                cause_code=cause_code,
+                error=exc,
+                attempt=attempt,
+                max_attempts=max_attempts,
+            )
+            active_logger.error(json.dumps(payload, sort_keys=True))
+
+            if attempt >= max_attempts:
+                raise
+
+            sleep_for = random.uniform(0.0, max(0.0, jitter_seconds))
+            if sleep_for:
+                time.sleep(sleep_for)
+