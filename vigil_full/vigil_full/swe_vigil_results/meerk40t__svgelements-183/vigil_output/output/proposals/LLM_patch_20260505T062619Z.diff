diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,48 @@
+import json
+import logging
+import random
+import time
+
+logger = logging.getLogger(__name__)
+
+
+def log_structured_error(cause_code, exc, **context):
+    """Emit machine-readable error details for thorn diagnosis."""
+    payload = {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "error_type": type(exc).__name__,
+        "message": str(exc),
+        "context": context,
+    }
+    logger.error(json.dumps(payload, sort_keys=True))
+
+
+def submit_with_observability(submit_callable, *args, **kwargs):
+    """Run agent.submit with structured logging and one jittered retry.
+
+    Recent RBT diagnosis identified agent.submit failures as the top thorn.
+    This wrapper preserves successful submit behavior while making failures
+    observable and giving transient failures one bounded retry opportunity.
+    """
+    try:
+        result = submit_callable(*args, **kwargs)
+        logger.info(
+            json.dumps(
+                {"event": "agent.submit", "status": "ok"},
+                sort_keys=True,
+            )
+        )
+        return result
+    except Exception as exc:
+        log_structured_error("agent.submit:fail", exc, attempt=1)
+        time.sleep(random.uniform(0.05, 0.25))
+        try:
+            result = submit_callable(*args, **kwargs)
+            logger.info(
+                json.dumps(
+                    {"event": "agent.submit", "status": "ok", "attempt": 2},
+                    sort_keys=True,
+                )
+            )
+            return result
+        except Exception as retry_exc:
+            log_structured_error("agent.submit:fail", retry_exc, attempt=2)
+            raise
+
