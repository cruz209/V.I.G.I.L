diff --git a/agent.py b/agent.py
index 8b13789..0f3c2ab 100644
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,62 @@
+import json
+import logging
+import random
+import time
+from typing import Any, Callable, Dict, Optional, TypeVar
+
+logger = logging.getLogger(__name__)
+
+T = TypeVar("T")
+
+
+def log_structured_event(
+    event: str,
+    *,
+    status: str,
+    cause_code: str,
+    details: Optional[Dict[str, Any]] = None,
+) -> None:
+    """Emit machine-readable telemetry for agent operations.
+
+    Recent reflection identified an ``agent.submit`` failure as the top thorn.
+    Keeping these events structured makes future failures diagnosable without
+    changing successful paths.
+    """
+    payload: Dict[str, Any] = {
+        "event": event,
+        "status": status,
+        "cause_code": cause_code,
+        "details": details or {},
+    }
+    logger.info("agent_event=%s", json.dumps(payload, sort_keys=True, default=str))
+
+
+def call_with_submit_observability(
+    operation: Callable[[], T],
+    *,
+    operation_name: str = "agent.submit",
+    max_attempts: int = 2,
+    base_jitter_seconds: float = 0.25,
+) -> T:
+    """Run a submit operation with structured errors and one jittered retry.
+
+    Use this wrapper around submit paths so transient tool/API failures are
+    retried once and all failures include a stable cause code for RBT analysis.
+    """
+    if max_attempts < 1:
+        raise ValueError("max_attempts must be at least 1")
+
+    last_exc: Optional[BaseException] = None
+    for attempt in range(1, max_attempts + 1):
+        try:
+            result = operation()
+            log_structured_event(
+                operation_name,
+                status="ok",
+                cause_code=f"{operation_name}:ok",
+                details={"attempt": attempt},
+            )
+            return result
+        except Exception as exc:  # pragma: no cover - preserves original failure
+            last_exc = exc
+            log_structured_event(
+                operation_name,
+                status="fail",
+                cause_code=f"{operation_name}:fail",
+                details={"attempt": attempt, "error": repr(exc)},
+            )
+            if attempt < max_attempts:
+                time.sleep(random.uniform(0, base_jitter_seconds))
+    assert last_exc is not None
+    raise last_exc
+
