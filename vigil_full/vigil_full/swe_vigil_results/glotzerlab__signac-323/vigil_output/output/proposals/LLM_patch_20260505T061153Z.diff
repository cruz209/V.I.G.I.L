diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,0 +1,98 @@
+"""Agent observability and retry helpers.
+
+This module-level utility hardens submit paths by emitting structured logs and
+retrying one transient failure with jitter.  Callers can adopt
+``submit_with_observability`` around the existing submit callable without
+changing successful behavior.
+"""
+
+import json as _json
+import logging as _logging
+import random as _random
+import time as _time
+from typing import Any as _Any
+from typing import Callable as _Callable
+from typing import Dict as _Dict
+from typing import Optional as _Optional
+
+
+_ROBIN_AGENT_LOGGER = _logging.getLogger("robin_b.agent")
+
+
+def _safe_json_default(value: _Any) -> str:
+    """Return a stable string for values that are not JSON serializable."""
+    return repr(value)
+
+
+def log_structured_agent_event(
+    event: str,
+    *,
+    cause_code: str,
+    status: str,
+    attempt: _Optional[int] = None,
+    max_attempts: _Optional[int] = None,
+    error: _Optional[BaseException] = None,
+    extra: _Optional[_Dict[str, _Any]] = None,
+) -> None:
+    """Emit a structured agent event with a cause code for diagnosis.
+
+    The RBT reflection identified ``agent.submit:fail`` as the top thorn.  These
+    logs make future failures searchable while preserving successful submit
+    behavior.
+    """
+    payload: _Dict[str, _Any] = {
+        "event": event,
+        "cause_code": cause_code,
+        "status": status,
+    }
+    if attempt is not None:
+        payload["attempt"] = attempt
+    if max_attempts is not None:
+        payload["max_attempts"] = max_attempts
+    if error is not None:
+        payload["error_type"] = type(error).__name__
+        payload["error_message"] = str(error)
+    if extra:
+        payload.update(extra)
+
+    message = _json.dumps(payload, sort_keys=True, default=_safe_json_default)
+    if status == "failed":
+        _ROBIN_AGENT_LOGGER.error(message)
+    elif status == "retrying":
+        _ROBIN_AGENT_LOGGER.warning(message)
+    else:
+        _ROBIN_AGENT_LOGGER.info(message)
+
+
+def submit_with_observability(
+    submit_callable: _Callable[..., _Any],
+    *args: _Any,
+    cause_code: str = "agent.submit",
+    max_attempts: int = 2,
+    retry_jitter_seconds: float = 0.25,
+    **kwargs: _Any,
+) -> _Any:
+    """Run a submit callable with structured logging and one jittered retry.
+
+    Args:
+        submit_callable: Existing submit function/method to invoke.
+        *args: Positional arguments passed through unchanged.
+        cause_code: Stable diagnostic code, e.g. ``agent.submit``.
+        max_attempts: Total attempts. Defaults to 2 to auto-retry once.
+        retry_jitter_seconds: Upper bound for random retry sleep.
+        **kwargs: Keyword arguments passed through unchanged.
+
+    Returns:
+        The submit callable's successful result.
+
+    Raises:
+        The final exception if every attempt fails.
+    """
+    if max_attempts < 1:
+        raise ValueError("max_attempts must be >= 1")
+    if retry_jitter_seconds < 0:
+        raise ValueError("retry_jitter_seconds must be >= 0")
+
+    for attempt in range(1, max_attempts + 1):
+        try:
+            result = submit_callable(*args, **kwargs)
+            log_structured_agent_event(
+                "agent_submit",
+                cause_code=cause_code,
+                status="ok",
+                attempt=attempt,
+                max_attempts=max_attempts,
+            )
+            return result
+        except Exception as exc:
+            if attempt >= max_attempts:
+                log_structured_agent_event(
+                    "agent_submit",
+                    cause_code=f"{cause_code}:fail",
+                    status="failed",
+                    attempt=attempt,
+                    max_attempts=max_attempts,
+                    error=exc,
+                )
+                raise
+
+            jitter = _random.uniform(0, retry_jitter_seconds)
+            log_structured_agent_event(
+                "agent_submit",
+                cause_code=f"{cause_code}:retry",
+                status="retrying",
+                attempt=attempt,
+                max_attempts=max_attempts,
+                error=exc,
+                extra={"retry_sleep_seconds": round(jitter, 6)},
+            )
+            if jitter:
+                _time.sleep(jitter)
