diff --git a/agent.py b/agent.py
--- a/agent.py
+++ b/agent.py
@@ -1,3 +1,54 @@
+import json
+import logging
+import random
+import time
+
+
+logger = logging.getLogger(__name__)
+
+
+def _log_structured_error(cause_code, exc, **context):
+    """Emit structured error logs for agent failures.
+
+    The RBT review identified `agent.submit:fail` as the active thorn.  Keeping
+    error payloads structured makes submit failures searchable while preserving
+    the successful shell execution path.
+    """
+    payload = {
+        "event": "agent.error",
+        "cause_code": cause_code,
+        "error_type": type(exc).__name__,
+        "error": str(exc),
+        "context": context,
+    }
+    logger.error(json.dumps(payload, sort_keys=True))
+
+
+def retry_once_with_jitter(fn, *, cause_code="agent.submit:fail", jitter_seconds=0.25, **context):
+    """Run `fn`, retrying once after jitter and logging structured failures.
+
+    Use this around submit/tool-call boundaries so transient failures are
+    retried once and persistent failures surface with a machine-readable cause
+    code.
+    """
+    try:
+        return fn()
+    except Exception as exc:
+        _log_structured_error(cause_code, exc, attempt=1, **context)
+        time.sleep(random.uniform(0, jitter_seconds))
+
+    try:
+        return fn()
+    except Exception as exc:
+        _log_structured_error(cause_code, exc, attempt=2, **context)
+        raise
+
+
+def validate_submit_result(result):
+    """Validate submit responses before treating them as successful."""
+    if result is None:
+        raise ValueError("agent.submit returned no result")
+    return result
+
 